# Copy this file to .env and fill in real values. Never commit .env itself.

# Generate with: npm run hash-password -- "your-password-here"
ADMIN_PASSWORD_HASH=

# Any long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional, defaults to 3000
PORT=3000

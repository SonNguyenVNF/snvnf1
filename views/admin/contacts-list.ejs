<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tin nhắn liên hệ — Quản trị Synetic Group</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/assets/admin.css" rel="stylesheet">
</head><body>
<div class="admin-topbar">
  <b>Synetic — Quản trị</b>
  <form method="POST" action="/admin/logout" style="margin:0"><a href="#" onclick="this.closest('form').submit();return false" style="cursor:pointer">Đăng xuất</a></form>
</div>
<div class="admin-wrap">
  <div class="admin-nav"><a href="/admin">← Trang quản trị</a></div>
  <div class="admin-card">
    <h1>Tin nhắn liên hệ</h1>
    <p style="color:var(--muted);font-size:13.5px;margin-bottom:20px">Thông tin khách để lại qua biểu mẫu "Gửi thông tin" ở chân trang và trang dự án. Chấm đỏ là tin chưa đọc.</p>

    <% items.forEach(function(m) { %>
    <div class="msg-item<%= m.read ? '' : ' unread' %>">
      <div class="who"><%= m.name %></div>
      <div class="meta"><%= m.phone || '' %><% if (m.phone && m.email) { %> · <% } %><%= m.email || '' %> · <%= new Date(m.createdAt).toLocaleString('vi-VN') %> · từ trang <%= m.page %></div>
      <div class="body"><%= m.message %></div>
      <div style="margin-top:10px;display:flex;gap:8px">
        <form method="POST" action="/admin/tin-nhan/<%= m.id %>/read" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-btn admin-btn-ghost" type="submit"><%= m.read ? 'Đánh dấu chưa đọc' : 'Đánh dấu đã đọc' %></button></form>
        <form method="POST" action="/admin/tin-nhan/<%= m.id %>/delete" style="margin:0" onsubmit="return confirm('Xoá tin nhắn này?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-btn admin-btn-danger" type="submit">Xoá</button></form>
      </div>
    </div>
    <% }); %>
    <% if (!items.length) { %><p style="color:var(--muted)">Chưa có tin nhắn nào.</p><% } %>
  </div>
</div>
</body></html>

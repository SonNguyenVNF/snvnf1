<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Giá trị cốt lõi — Quản trị Synetic Group</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="/assets/style.css" rel="stylesheet">
<link href="/assets/admin.css" rel="stylesheet">
</head><body>
<div class="admin-topbar">
  <b>Synetic — Quản trị</b>
  <form method="POST" action="/admin/logout" style="margin:0"><a href="#" onclick="this.closest('form').submit();return false" style="cursor:pointer">Đăng xuất</a></form>
</div>
<div class="admin-wrap">
  <div class="admin-nav"><a href="/admin">← Trang quản trị</a></div>
  <div class="admin-card">
    <h1>Giá trị cốt lõi</h1>
    <p style="color:var(--muted);font-size:13.5px;margin-bottom:20px">6 ô "Sáu giá trị dẫn đường" hiển thị trên trang chủ.</p>
    <% if (error) { %><div class="admin-error"><%= error %></div><% } %>

    <form method="POST" action="/admin/gia-tri">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% items.forEach(function(item, i) { %>
        <div class="admin-field" style="border-top:1px solid #ECEAE3;padding-top:16px;margin-top:16px">
          <label>Giá trị <%= i + 1 %> — Tên</label>
          <input type="text" name="title" value="<%= item.title %>" required>
          <label style="margin-top:10px">Mô tả ngắn</label>
          <input type="text" name="description" value="<%= item.description %>">
        </div>
      <% }); %>

      <button class="admin-btn" type="submit" style="margin-top:20px">Lưu thay đổi</button>
    </form>
  </div>
</div>
</body></html>

<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Slide trang chủ — Quản trị Synetic Group</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="/assets/style.css" rel="stylesheet">
<link href="/assets/admin.css" rel="stylesheet">
</head><body>
<div class="admin-topbar">
  <b>Synetic — Quản trị</b>
  <form method="POST" action="/admin/logout" style="margin:0"><a href="#" onclick="this.closest('form').submit();return false" style="cursor:pointer">Đăng xuất</a></form>
</div>
<div class="admin-wrap">
  <div class="admin-nav"><a href="/admin">← Trang quản trị</a></div>
  <div class="admin-card">
    <h1>Slide trang chủ</h1>
    <p style="color:var(--muted);font-size:13.5px;margin-bottom:24px">Ảnh nền + tiêu đề + mô tả hiển thị lần lượt ở đầu trang chủ. Khách xem có thể bấm mũi tên để chủ động xem từng slide. Dùng mũi tên ↑↓ dưới đây để đổi thứ tự. Chỉ slide đã bật "Hiển thị" mới lên trang.</p>

    <a class="admin-btn" href="/admin/hero/new" style="margin-bottom:20px;display:inline-block">+ Thêm slide mới</a>

    <ul class="admin-list">
      <% items.forEach(function(item, idx) { %>
      <li>
        <div style="display:flex;align-items:center;gap:14px">
          <img src="/<%= item.image %>" alt="" style="width:64px;height:44px;object-fit:cover;border-radius:6px;flex:none">
          <div>
            <div class="txt"><%= item.title.replace(/\*\*/g, '') %>
              <% if (!item.published) { %><span style="color:#B3261E;font-size:11.5px;font-weight:700;margin-left:8px">(Ẩn)</span><% } %>
            </div>
            <div class="url"><%= item.eyebrow || '' %></div>
          </div>
        </div>
        <span class="actions">
          <form method="POST" action="/admin/hero/<%= item.id %>/move" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="direction" value="up">
            <button class="admin-btn admin-btn-ghost" type="submit" <%= idx === 0 ? 'disabled' : '' %>>↑</button>
          </form>
          <form method="POST" action="/admin/hero/<%= item.id %>/move" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="direction" value="down">
            <button class="admin-btn admin-btn-ghost" type="submit" <%= idx === items.length - 1 ? 'disabled' : '' %>>↓</button>
          </form>
          <a class="admin-btn admin-btn-ghost" href="/admin/hero/<%= item.id %>/edit">Sửa</a>
          <form method="POST" action="/admin/hero/<%= item.id %>/delete" onsubmit="return confirm('Xoá slide này?')" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="admin-btn admin-btn-danger" type="submit">Xoá</button>
          </form>
        </span>
      </li>
      <% }); %>
      <% if (!items.length) { %><li><span class="txt" style="color:var(--muted)">Chưa có slide nào.</span></li><% } %>
    </ul>
  </div>
</div>
</body></html>

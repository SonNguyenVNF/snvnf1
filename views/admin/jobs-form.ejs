<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= item ? 'Sửa tin tuyển dụng' : 'Thêm tin tuyển dụng' %> — Quản trị Synetic Group</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/assets/admin.css" rel="stylesheet">
</head><body>
<div class="admin-topbar">
  <b>Synetic — Quản trị</b>
  <form method="POST" action="/admin/logout" style="margin:0"><a href="#" onclick="this.closest('form').submit();return false" style="cursor:pointer">Đăng xuất</a></form>
</div>
<div class="admin-wrap">
  <div class="admin-nav"><a href="/admin/tuyen-dung">← Tuyển dụng</a></div>
  <div class="admin-card">
    <h1><%= item ? 'Sửa tin tuyển dụng' : 'Thêm tin tuyển dụng' %></h1>
    <% if (error) { %><div class="admin-error"><%= error %></div><% } %>
    <form method="POST" action="<%= item ? '/admin/tuyen-dung/' + item.id + '/edit' : '/admin/tuyen-dung/new' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="admin-field">
        <label for="title">Vị trí tuyển dụng</label>
        <input type="text" id="title" name="title" required value="<%= item ? item.title : '' %>" placeholder="Ví dụ: Chuyên viên Marketing tổng hợp">
      </div>

      <div class="admin-field">
        <label for="department">Phòng ban (dùng cho bộ lọc "Các phòng ban")</label>
        <input type="text" id="department" name="department" value="<%= item ? (item.department || '') : '' %>" placeholder="Ví dụ: Pr - Marketing">
      </div>

      <div class="admin-field">
        <label for="location">Địa điểm làm việc (hiện dưới tên vị trí, dùng cho bộ lọc)</label>
        <input type="text" id="location" name="location" value="<%= item ? (item.location || '') : '' %>" placeholder="Ví dụ: Tầng 17, Tòa nhà Charmvit Tower, 117 Trần Duy Hưng, Hà Nội">
      </div>

      <div class="admin-field">
        <label for="area">Khu vực (dùng cho bộ lọc "Địa điểm làm việc" bên trái; để trống thì dùng địa điểm ở trên)</label>
        <input type="text" id="area" name="area" value="<%= item ? (item.area || '') : '' %>" placeholder="Ví dụ: Văn phòng Thành phố Hà Nội">
      </div>

      <div class="admin-field">
        <label for="postedAt">Ngày đăng</label>
        <input type="date" id="postedAt" name="postedAt" value="<%= item ? (item.postedAt || today) : today %>">
      </div>

      <div class="admin-field">
        <label for="body">Nội dung tuyển dụng</label>
        <p class="hint">Gõ <b># MÔ TẢ CÔNG VIỆC</b> để tạo tiêu đề mục, <b>- nội dung</b> để tạo gạch đầu dòng, <b>**chữ đậm**</b> để in đậm. Cách 1 dòng trống để tách đoạn.</p>
        <textarea id="body" name="body" rows="16" placeholder="# MÔ TẢ CÔNG VIỆC&#10;1. ...&#10;&#10;# YÊU CẦU ỨNG VIÊN&#10;1. ...&#10;&#10;# QUYỀN LỢI&#10;- ..."><%= item ? (item.body || '') : '' %></textarea>
      </div>

      <div class="admin-field">
        <label><input type="checkbox" name="published" value="1" <%= (!item || item.published) ? 'checked' : '' %> style="width:auto;margin-right:8px"> Hiển thị trên website</label>
      </div>

      <button class="admin-btn" type="submit"><%= item ? 'Lưu thay đổi' : 'Thêm tin tuyển dụng' %></button>
      <a class="admin-btn admin-btn-ghost" href="/admin/tuyen-dung" style="margin-left:8px">Huỷ</a>
    </form>
  </div>
</div>
</body></html>

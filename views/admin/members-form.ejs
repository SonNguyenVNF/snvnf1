<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= item ? 'Sửa thành viên' : 'Thêm thành viên' %> — Quản trị Synetic Group</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/assets/admin.css" rel="stylesheet">
</head><body>
<div class="admin-topbar">
  <b>Synetic — Quản trị</b>
  <form method="POST" action="/admin/logout" style="margin:0"><a href="#" onclick="this.closest('form').submit();return false" style="cursor:pointer">Đăng xuất</a></form>
</div>
<div class="admin-wrap">
  <div class="admin-nav"><a href="/admin/thanh-vien">← Thành viên hệ sinh thái</a></div>
  <div class="admin-card">
    <h1><%= item ? 'Sửa thành viên' : 'Thêm thành viên' %></h1>
    <% if (error) { %><div class="admin-error"><%= error %></div><% } %>
    <form method="POST" action="<%= item ? '/admin/thanh-vien/' + item.id + '/edit' : '/admin/thanh-vien/new' %>" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="admin-field">
        <label for="name">Tên công ty</label>
        <input type="text" id="name" name="name" required value="<%= item ? item.name : '' %>" placeholder="Ví dụ: Synetic Dinh Dưỡng">
      </div>

      <div class="admin-field">
        <label for="pageTitle">Tiêu đề lớn ở đầu trang chi tiết (để trống thì dùng tên công ty)</label>
        <input type="text" id="pageTitle" name="pageTitle" value="<%= item ? (item.pageTitle || '') : '' %>" placeholder="Ví dụ: SYNETIC NUTRITION">
      </div>

      <div class="admin-field">
        <label for="brandSub">Chữ nhỏ dưới logo (không dấu, viết hoa)</label>
        <input type="text" id="brandSub" name="brandSub" value="<%= item ? item.brandSub : '' %>" placeholder="Ví dụ: NUTRITION">
      </div>

      <div class="admin-field">
        <label for="tagline">Khẩu hiệu (câu chữ nghiêng dưới logo ở mục Hệ sinh thái trang chủ và đầu trang chi tiết)</label>
        <input type="text" id="tagline" name="tagline" value="<%= item ? (item.tagline || '') : '' %>" placeholder="Ví dụ: Chuẩn dinh dưỡng, bền tăng trưởng">
      </div>

      <div class="admin-field">
        <label for="netName">Tên mạng (chữ màu dưới logo ở mục Hệ sinh thái trang chủ)</label>
        <input type="text" id="netName" name="netName" value="<%= item ? (item.netName || '') : '' %>" placeholder="Ví dụ: MẠNG DINH DƯỠNG">
      </div>

      <div class="admin-field">
        <label for="netDesc">Mô tả dưới tên mạng (đoạn chữ xám nhỏ ở mục Hệ sinh thái trang chủ)</label>
        <textarea id="netDesc" name="netDesc" rows="3"><%= item ? (item.netDesc || '') : '' %></textarea>
      </div>

      <div class="admin-field">
        <label for="legalName">Tên công ty pháp lý</label>
        <input type="text" id="legalName" name="legalName" value="<%= item ? (item.legalName || '') : '' %>" placeholder="Ví dụ: Công ty Cổ phần Synetic Dinh Dưỡng">
      </div>

      <div class="admin-field">
        <label for="accent">Màu chủ đạo trang chi tiết</label>
        <select id="accent" name="accent">
          <option value="emerald" <%= (!item || item.accent === 'emerald') ? 'selected' : '' %>>Xanh lá đậm</option>
          <option value="jade" <%= (item && item.accent === 'jade') ? 'selected' : '' %>>Xanh ngọc</option>
          <option value="ocean" <%= (item && item.accent === 'ocean') ? 'selected' : '' %>>Xanh dương</option>
          <option value="gold" <%= (item && item.accent === 'gold') ? 'selected' : '' %>>Vàng đồng</option>
        </select>
      </div>

      <div class="admin-field">
        <label for="logo">Logo</label>
        <% if (item && item.logo) { %>
          <div style="margin-bottom:10px"><img src="/<%= item.logo %>" alt="" style="max-width:140px;max-height:100px;object-fit:contain;background:var(--iv);border-radius:8px;padding:8px;display:block"></div>
        <% } %>
        <input type="file" id="logo" name="logo" accept=".jpg,.jpeg,.png,.webp,.gif">
        <p style="font-size:12px;color:var(--muted);margin-top:6px">Để trống nếu chưa có ảnh — trang sẽ tự hiện biểu tượng mặc định.</p>
      </div>

      <div class="admin-field">
        <label for="body">Giới thiệu (xuống dòng cách 1 dòng trống để tách đoạn)</label>
        <textarea id="body" name="body" rows="8"><%= item ? item.body : '' %></textarea>
      </div>

      <div class="admin-field">
        <label for="factsTitle">Tiêu đề cột bên phải (để trống nếu không cần). Ví dụ: THÔNG TIN NHANH hoặc SẢN PHẨM TIÊU BIỂU</label>
        <input type="text" id="factsTitle" name="factsTitle" value="<%= item ? (item.factsTitle || '') : '' %>" placeholder="Ví dụ: THÔNG TIN NHANH">
      </div>
      <% for (let i = 1; i <= 3; i++) { const f = item && item.facts && item.facts[i - 1]; %>
        <div class="admin-field" style="background:#F7F5EF;padding:12px;border-radius:8px">
          <div style="display:flex;gap:10px">
            <div style="flex:1"><label>Thẻ <%= i %> — Tiêu đề</label><input type="text" name="factLabel<%= i %>" value="<%= f ? f.label : '' %>"></div>
            <div style="flex:1"><label>Thẻ <%= i %> — Nội dung</label><input type="text" name="factValue<%= i %>" value="<%= f ? f.value : '' %>"></div>
          </div>
          <label style="margin-top:10px">Thẻ <%= i %> — Ảnh nhỏ bên trái</label>
          <% if (f && f.image) { %>
            <div style="margin-bottom:8px"><img src="/<%= f.image %>" alt="" style="width:120px;height:52px;object-fit:cover;border-radius:6px;display:block"></div>
            <label style="font-weight:400"><input type="checkbox" name="factImageRemove<%= i %>" value="1" style="width:auto"> Xoá ảnh này</label>
          <% } %>
          <input type="file" name="factImage<%= i %>" accept=".jpg,.jpeg,.png,.webp,.gif">
        </div>
      <% } %>

      <div class="admin-field">
        <label for="unitsTitle">Phần cuối trang: tiêu đề các đơn vị thành viên (để trống nếu công ty này không có đơn vị con — trang sẽ hiện danh sách 5 công ty của hệ sinh thái)</label>
        <input type="text" id="unitsTitle" name="unitsTitle" value="<%= item ? (item.unitsTitle || '') : '' %>" placeholder="Ví dụ: CÁC ĐƠN VỊ THÀNH VIÊN TRONG LĨNH VỰC VẬN TẢI">
      </div>
      <% for (let i = 1; i <= 4; i++) { const u = item && item.units && item.units[i - 1]; %>
        <div class="admin-field" style="background:#F7F5EF;padding:12px;border-radius:8px">
          <div style="display:flex;gap:10px">
            <div style="flex:1"><label>Đơn vị <%= i %> — Tên công ty (hiện dưới logo)</label><input type="text" name="unitName<%= i %>" value="<%= u ? u.name : '' %>"></div>
            <div style="flex:1"><label>Đơn vị <%= i %> — Link của nút "Tìm hiểu thêm"</label><input type="text" name="unitUrl<%= i %>" value="<%= u ? (u.url || '') : '' %>" placeholder="https://..."></div>
          </div>
          <label style="margin-top:10px">Đơn vị <%= i %> — Logo</label>
          <% if (u && u.logo) { %>
            <div style="margin-bottom:8px"><img src="/<%= u.logo %>" alt="" style="max-width:160px;max-height:90px;object-fit:contain;background:#fff;border-radius:6px;padding:6px;display:block"></div>
            <label style="font-weight:400"><input type="checkbox" name="unitLogoRemove<%= i %>" value="1" style="width:auto"> Xoá đơn vị này (bỏ logo)</label>
          <% } %>
          <input type="file" name="unitLogo<%= i %>" accept=".jpg,.jpeg,.png,.webp,.gif">
        </div>
      <% } %>

      <div class="admin-field">
        <label><input type="checkbox" name="published" value="1" <%= (!item || item.published) ? 'checked' : '' %> style="width:auto;margin-right:8px"> Hiển thị trên website</label>
      </div>

      <button class="admin-btn" type="submit"><%= item ? 'Lưu thay đổi' : 'Thêm thành viên' %></button>
      <a class="admin-btn admin-btn-ghost" href="/admin/thanh-vien" style="margin-left:8px">Huỷ</a>
    </form>
  </div>
</div>
<script src="/assets/admin-search.js" defer></script>
<script src="/assets/admin-upload.js" defer></script>
</body></html>

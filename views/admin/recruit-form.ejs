<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chữ trang Cơ hội việc làm — Quản trị Synetic Group</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/assets/admin.css" rel="stylesheet">
</head><body>
<div class="admin-topbar">
  <b>Synetic — Quản trị</b>
  <form method="POST" action="/admin/logout" style="margin:0"><a href="#" onclick="this.closest('form').submit();return false" style="cursor:pointer">Đăng xuất</a></form>
</div>
<div class="admin-wrap">
  <div class="admin-nav"><a href="/admin">← Trang quản trị</a></div>
  <div class="admin-card">
    <h1>Chữ trang Cơ hội việc làm</h1>
    <p style="color:var(--muted);font-size:13.5px;margin-bottom:20px">Phần chữ ở dải xanh đầu trang, 3 con số và mục "Vì sao bạn nên lựa chọn". Danh sách vị trí tuyển dụng quản lý ở mục "Tuyển dụng".</p>
    <% if (saved) { %><div class="admin-error" style="background:#E7F6EC;color:#14602F">Đã lưu thay đổi.</div><% } %>

    <form method="POST" action="/admin/trang-tuyen-dung">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="admin-field"><label for="heroTitle">Tiêu đề (chữ vàng)</label><input type="text" id="heroTitle" name="heroTitle" value="<%= r.heroTitle %>"></div>
      <div class="admin-field"><label for="heroSub">Dòng phụ (chữ trắng đậm)</label><input type="text" id="heroSub" name="heroSub" value="<%= r.heroSub %>"></div>
      <div class="admin-field"><label for="heroText">Đoạn giới thiệu phía trên (mỗi dòng là 1 đoạn)</label><textarea id="heroText" name="heroText" rows="4"><%= r.heroText %></textarea></div>

      <h3 style="margin:22px 0 10px;padding-top:16px;border-top:1px solid #ECEAE3">3 con số trong khung trắng</h3>
      <% for (var i = 0; i < 3; i++) { var s = r.stats[i] || { value: '', text: '' }; %>
      <div class="admin-field" style="background:#F7F5EF;padding:12px;border-radius:8px">
        <label>Con số <%= i + 1 %> (ví dụ 100+)</label><input type="text" name="statValue" value="<%= s.value %>">
        <label style="margin-top:10px">Chú thích</label><input type="text" name="statText" value="<%= s.text %>">
      </div>
      <% } %>

      <div class="admin-field"><label for="heroText2">Đoạn chữ phía dưới khung số (mỗi dòng là 1 đoạn)</label><textarea id="heroText2" name="heroText2" rows="4"><%= r.heroText2 %></textarea></div>

      <h3 style="margin:22px 0 10px;padding-top:16px;border-top:1px solid #ECEAE3">Mục "Vì sao bạn nên lựa chọn"</h3>
      <div class="admin-field row2">
        <div><label for="whyTitle">Tiêu đề (xanh)</label><input type="text" id="whyTitle" name="whyTitle" value="<%= r.whyTitle %>"></div>
        <div><label for="whyHighlight">Dòng vàng</label><input type="text" id="whyHighlight" name="whyHighlight" value="<%= r.whyHighlight %>"></div>
      </div>
      <% for (var j = 0; j < Math.max(5, r.whyItems.length + 1); j++) { var w = r.whyItems[j] || { title: '', text: '' }; %>
      <div class="admin-field" style="background:#F7F5EF;padding:12px;border-radius:8px">
        <label>Lý do <%= j + 1 %> — Tên (để trống để xoá)</label><input type="text" name="whyItemTitle" value="<%= w.title %>">
        <label style="margin-top:10px">Mô tả</label><textarea name="whyItemText" rows="2"><%= w.text %></textarea>
      </div>
      <% } %>

      <button class="admin-btn" type="submit" style="margin-top:16px">Lưu thay đổi</button>
    </form>
  </div>
</div>
</body></html>

<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chữ cố định — Quản trị Synetic Group</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/assets/admin.css" rel="stylesheet">
<style>
  .ut-find{position:sticky;top:0;background:#fff;padding:10px 0;z-index:5;border-bottom:1px solid #ECEAE3;margin-bottom:6px}
  .ut-grp{margin-top:26px}
  .ut-grp h2{margin-bottom:6px}
  .ut-row{border-top:1px solid #F0EEE8;padding:12px 0}
  .ut-row label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:5px}
  .ut-row input,.ut-row textarea{width:100%;padding:9px 11px;border:1.5px solid #DDE6E0;border-radius:8px;font:inherit;font-size:14px;color:var(--ch);background:#fff}
  .ut-row.hide{display:none}
</style>
</head><body>
<div class="admin-topbar">
  <b>Synetic — Quản trị</b>
  <form method="POST" action="/admin/logout" style="margin:0"><a href="#" onclick="this.closest('form').submit();return false" style="cursor:pointer">Đăng xuất</a></form>
</div>
<div class="admin-wrap" style="max-width:860px">
  <div class="admin-nav"><a href="/admin">← Trang quản trị</a></div>
  <div class="admin-card">
    <h1>Chữ cố định trên website</h1>
    <p style="color:var(--muted);font-size:13.5px;margin-bottom:14px">Những chữ không thuộc bài viết nào: menu, nút bấm, tiêu đề các mục, gợi ý trong ô nhập, thông báo, tên hiện trên tab trình duyệt... Ô nào để trống thì website dùng chữ mặc định (hiện mờ trong ô). Chữ trong các bài tin, dự án, thành viên, trang chủ... vẫn sửa ở các mục riêng của chúng.</p>
    <% if (saved) { %><div class="admin-error" style="background:#E7F6EC;color:#14602F">Đã lưu thay đổi.</div><% } %>

    <form method="POST" action="/admin/chu-co-dinh">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="ut-find"><input type="search" id="utq" placeholder="Gõ để lọc, ví dụ: xem thêm, menu, form..." style="width:100%;padding:10px 14px;border:1.5px solid #DDE6E0;border-radius:20px;font:inherit;font-size:14px"></div>
      <% groups.forEach(function(g) { %>
      <div class="ut-grp">
        <h2><%= g.name %></h2>
        <% g.items.forEach(function(it) { %>
        <div class="ut-row" data-q="<%= (it.label + ' ' + it.def + ' ' + it.value + ' ' + g.name).toLowerCase() %>">
          <label for="v_<%= it.key %>"><%= it.label %></label>
          <% if (it.def.length > 70 || it.value.length > 70) { %>
          <textarea id="v_<%= it.key %>" name="v_<%= it.key %>" rows="2" placeholder="<%= it.def %>"><%= it.value %></textarea>
          <% } else { %>
          <input type="text" id="v_<%= it.key %>" name="v_<%= it.key %>" value="<%= it.value %>" placeholder="<%= it.def %>">
          <% } %>
        </div>
        <% }); %>
      </div>
      <% }); %>
      <button class="admin-btn" type="submit" style="margin-top:22px">Lưu thay đổi</button>
    </form>
  </div>
</div>
<script>
  var q = document.getElementById('utq');
  q.addEventListener('input', function () {
    var s = q.value.toLowerCase().trim();
    document.querySelectorAll('.ut-row').forEach(function (r) { r.classList.toggle('hide', !!s && r.getAttribute('data-q').indexOf(s) === -1); });
    document.querySelectorAll('.ut-grp').forEach(function (g) { g.style.display = g.querySelector('.ut-row:not(.hide)') ? '' : 'none'; });
  });
</script>
<script src="/assets/admin-search.js" defer></script>
</body></html>

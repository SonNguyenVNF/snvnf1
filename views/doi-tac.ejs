<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: t('title.partners'), root: root, assetVersion: assetVersion, siteImages: siteImages, fxStyle: fxStyle, fontCss: fontCss }) %></head>
<body class="t-green">
<%- include('partials/header', { root: root, active: 'doi-tac', siteImages: siteImages }) %>
<%- include('partials/banner', { root: root, title: t('banner.partners'), siteImages: siteImages }) %>
<%
function lines(t) { return String(t || '').replace(/\r\n/g, '\n').split(/\n+/).map(function(x) { return x.trim(); }).filter(Boolean); }
function intro(t) { return String(t || '').replace(/\r\n/g, '\n').split(/\n{2,}/).map(function(x) { return x.trim(); }).filter(Boolean); }
%>
<main class="pt-main"><div class="wrap">
  <header class="pt-head">
    <h2><%= page.title %></h2>
    <p><%= page.sub %></p>
    <h3><%= page.headline %></h3>
  </header>

  <% if (featured) { %>
  <section class="pt-feature"<%- fx('partners-feature') %>>
    <div class="pt-fimg"><% var fi = (featured.images && featured.images[0]) || featured.logo; %><% if (fi) { %><img src="<%= root %><%= fi %>" alt="<%= featured.name %>"><% } %><% if (featured.modalTitle || featured.name) { %><span class="cap"><%= featured.imageCaption || '' %></span><% } %></div>
    <div class="pt-fcard">
      <h3><%= featured.modalTitle || featured.name %></h3>
      <p><%= featured.summary %></p>
      <% if (lines(featured.bullets).length) { %><p class="lead"><%= t('pt.focus') %></p>
      <ul class="chk"><% lines(featured.bullets).forEach(function(b) { %><li><%= b %></li><% }); %></ul><% } %>
      <button class="btn btn-gold btn-lg" type="button" data-pmodal="<%= featured.id %>"><%= t('btn.detail') %> <span aria-hidden="true">↗</span></button>
    </div>
  </section>
  <% } %>

  <section class="pt-stats"<%- fx('partners-stats') %>>
    <% page.stats.forEach(function(s) { %><div><b data-count="<%= s.value %>"><%= s.value %></b><span><%= s.text %></span></div>
    <% }); %>
  </section>

  <section class="pt-list" data-ptlist data-per="8">
    <h2><%= page.listTitle %></h2>
    <div class="pt-chips" role="tablist">
      <button class="chip on" type="button" data-chip=""><%= t('pt.all') %></button>
      <% cats.forEach(function(c) { %><button class="chip" type="button" data-chip="<%= c %>"><%= c %></button>
      <% }); %>
    </div>
    <%# Each group is one row; a row with more cards than fit glides sideways on its own (nav.js). %>
    <div class="pt-rows"<%- fx('partners-logos') %>>
      <% groups.forEach(function(g) { %>
      <div class="pt-row" data-row data-cat="<%= g.name %>"><div class="pt-track">
        <% g.items.forEach(function(p) { %>
        <article class="pt-card" data-item data-cat="<%= p.category %>">
          <div class="pt-logo"><% if (p.logo) { %><img src="<%= root %><%= p.logo %>" alt="<%= p.name %>" loading="lazy"<% if (p.logoZoom && p.logoZoom !== 100) { %> style="--lz:<%= p.logoZoom / 100 %>"<% } %>><% } else { %><span><%= p.name %></span><% } %></div>
          <h3><%= p.name %></h3>
          <% if (p.category) { %><span class="pill"><%= p.category %></span><% } %>
          <p><%= p.summary %></p>
          <button class="btn btn-gold btn-block" type="button" data-pmodal="<%= p.id %>"><%= t('btn.detail') %></button>
        </article>
        <% }); %>
      </div></div>
      <% }); %>
      <p class="empty" data-empty<%= groups.length ? ' style=display:none' : '' %>><%= t('pt.empty') %></p>
    </div>
  </section>
</div></main>

<% partners.forEach(function(p) { var imgs = (p.images || []).filter(Boolean); %>
<div class="pmodal" id="pm-<%= p.id %>" role="dialog" aria-modal="true" aria-label="<%= p.name %>" hidden>
  <div class="pm-box">
    <button class="pm-x" type="button" aria-label="<%= t('aria.close') %>">×</button>
    <div class="pm-grid">
      <div class="pm-gal" data-gal>
        <% if (imgs.length) { %>
        <div class="pm-big"><img src="<%= root %><%= imgs[0] %>" alt="<%= p.name %>"><% if (p.imageCaption) { %><span class="cap"><%= p.imageCaption %></span><% } %></div>
        <% if (imgs.length > 1) { %><div class="pm-thumbs"><div class="pm-tt"><% imgs.slice(1).forEach(function(s) { %><button type="button" class="pm-th"><img src="<%= root %><%= s %>" alt=""></button><% }); %></div></div><% } %>
        <% } else if (p.logo) { %><div class="pm-big logo"><img src="<%= root %><%= p.logo %>" alt="<%= p.name %>"></div><% } %>
      </div>
      <div class="pm-info">
        <h2><%= p.modalTitle || p.name %></h2>
        <% if (intro(p.intro).length) { %><h4><%= t('pt.intro') %></h4>
        <% intro(p.intro).forEach(function(par, i) { var ls = par.split('\n'); %><p><% if (i === 0 && ls.length > 1) { %><strong><%= ls[0] %></strong><br><%= ls.slice(1).join(' ') %><% } else { %><%= par %><% } %></p>
        <% }); %><% } %>
        <% if (lines(p.bullets).length) { %><h4><%= t('pt.coop') %></h4>
        <ul class="chk"><% lines(p.bullets).forEach(function(b) { %><li><%= b %></li><% }); %></ul><% } %>
        <% if (p.quote) { %><blockquote><span class="qm">“</span><%= p.quote %><% if (p.quoteBy) { %><cite>- <%= p.quoteBy %></cite><% } %></blockquote><% } %>
        <a class="btn btn-gold btn-block btn-lg" href="<%= p.website || '#' %>"<% if (p.website) { %> target="_blank" rel="noopener"<% } %>><%= t('pt.web') %></a>
        <a class="btn btn-ghost btn-block btn-lg" href="<%= p.fanpage || '#' %>"<% if (p.fanpage) { %> target="_blank" rel="noopener"<% } %>><%= t('pt.fan') %></a>
      </div>
    </div>
  </div>
</div>
<% }); %>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion, fx: fx }) %>
</body></html>

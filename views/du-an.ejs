<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: 'Dự án — Synetic Group', root: root }) %></head><body>

<%- include('partials/header', { root: root, active: 'du-an' , siteImages: siteImages }) %>

<main>
<div class="abar wrap"><a href="index.html">← Về trang chủ</a> &nbsp;/&nbsp; Dự án</div>

<section class="ahero"><div class="wrap">
  <p class="k">DỰ ÁN</p>
  <h1>Dự án</h1>
</div></section>

<section class="abody"><div class="wrap">
  <% if (items.length) { %>
  <div class="newsgrid">
    <% items.forEach(function(item) { %>
    <div class="newscard">
      <% if (item.image) { %><img src="<%= root %><%= item.image %>" alt=""><% } %>
      <div class="nbody">
        <% if (item.location) { %><span class="ndate"><%= item.location %></span><% } %>
        <h4><%= item.title %></h4>
        <p><%= item.excerpt %></p>
      </div>
    </div>
    <% }); %>
  </div>
  <% } else { %>
  <p class="newsempty">Nội dung đang được cập nhật. Phần này sẽ sớm giới thiệu các dự án tiêu biểu của Synetic Group.</p>
  <% } %>
</div></section>
</main>

<%- include('partials/footer', { root: root, active: 'du-an' , siteImages: siteImages, footer: footer }) %>
<%- include('partials/ticker', { root: root, ticker: ticker }) %>
<%- include('partials/fab', { root: root, footer: footer }) %>
</body></html>

<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: t('title.home'), desc: homepage.introText, root: root, assetVersion: assetVersion, siteImages: siteImages, fxStyle: fxStyle, fontCss: fontCss }) %></head>
<body class="t-blue">
<%- include('partials/header', { root: root, active: 'home', siteImages: siteImages }) %>
<%
function highlightDesc(d) { d = d || ''; return d.indexOf('**') === -1 ? d.replace('đổi mới, kết nối và phát triển bền vững', '**đổi mới, kết nối và phát triển bền vững**') : d; }
var slides = heroSlides.length ? heroSlides : [{ image: siteImages.banner, title: 'KIẾN TẠO GIÁ TRỊ **VƯỢT TRỘI**', description: homepage.introText }];
%>
<main id="top">
<section class="hero" data-once="<%= homepage.heroAnimEvery === '0' ? '1' : '0' %>" data-interval="<%= homepage.heroSlideSeconds %>" style="--w-dur:<%= homepage.heroWordDuration %>s;--w-gap:<%= homepage.heroWordGap %>s;--w-start:<%= homepage.heroStartDelay %>s">
  <div class="hero-clouds" aria-hidden="true"><i></i><i></i><i></i></div>
  <% slides.forEach(function(slide, i) { %><div class="hslide<%= i === 0 ? ' active' : '' %>" style="background-image:url('<%= root %><%= slide.image %>')"></div>
  <% }); %>
  <% slides.forEach(function(slide, i) { %>
  <div class="hero-text<%= i === 0 ? ' active' : '' %>" style="--pd:<%= ((slide.title || '').replace(/\*\*/g, '').trim().split(/\s+/).length * parseFloat(homepage.heroWordGap) + parseFloat(homepage.heroStartDelay) + parseFloat(homepage.heroWordDuration) * 0.7).toFixed(2) %>s">
    <h1><%- renderHeroWords(slide.title) %></h1>
    <% if (slide.description) { %><p><%- renderHeroTitle(highlightDesc(slide.description)) %></p><% } %>
    <div class="hero-cta">
      <a class="btn btn-green" href="#thanh-vien"><%= homepage.heroBtn1 %></a>
      <a class="btn btn-yellow" href="<%= root %>ve-chung-toi.html#thong-diep-chu-tich-hdqt"><%= homepage.heroBtn2 %></a>
    </div>
  </div>
  <% }); %>
  <% if (slides.length > 1) { %>
  <button class="hero-arrow hero-prev" type="button" aria-label="<%= t('aria.slideprev') %>">‹</button>
  <button class="hero-arrow hero-next" type="button" aria-label="<%= t('aria.slidenext') %>">›</button>
  <div class="hero-dots"></div>
  <% } %>
</section>

<section class="intro" id="gioi-thieu"<%- fx('home-intro') %>>
  <div class="wrap">
    <div>
      <h2><%= homepage.introTitle %></h2>
      <h3><%= homepage.introSubtitle %></h3>
      <div class="rule"></div>
      <p><%= homepage.introText %></p>
      <a class="btn btn-green btn-lg" href="<%= root %>ve-chung-toi.html#lich-su"><%= homepage.introButton %></a>
    </div>
    <div class="frame"><img src="<%= root %><%= siteImages.intro %>" alt="<%= homepage.introTitle %>"></div>
  </div>
  <img class="pent-about" src="<%= root %><%= siteImages.pentagon %>" alt="">
</section>

<section class="members eco" id="thanh-vien"<%- fx('home-members') %>>
  <img class="wm l" src="<%= root %><%= siteImages.watermark %>" alt=""><img class="wm r" src="<%= root %><%= siteImages.watermark %>" alt="">
  <div class="wrap">
    <h2 class="t-h"><%= homepage.membersTitle %></h2>
    <div class="mgrid">
      <% members.forEach(function(m) { %>
      <div class="eco-i tone-<%= m.accent === 'ocean' ? 'blue' : (m.accent === 'gold' ? 'gold' : 'green') %>">
        <a class="ml" href="<%= root %>thanh-vien/<%= m.slug %>.html"><img src="<%= root %><%= m.logo %>" alt="<%= m.name %>" loading="lazy" onerror="this.onerror=null;this.src='<%= root %>assets/img/logo-m-<%= m.slug %>.png'"></a>
        <% if (m.tagline) { %><span class="eco-q"><%= cardQuote(m.tagline) %></span><% } %>
        <% if (m.netName) { %><h3><%= m.netName %></h3><% } %>
        <% if (m.netDesc) { %><p><%= m.netDesc %></p><% } %>
        <a class="btn btn-blue" href="<%= root %>thanh-vien/<%= m.slug %>.html"><%= t('btn.learn') %></a>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="partners-band"<%- fx('home-partners') %>>
  <img class="wm l" src="<%= root %><%= siteImages.watermark %>" alt="">  <img class="wm r" src="<%= root %><%= siteImages.watermark %>" alt="">  <div class="wrap">
    <h2><%= homepage.partnersTitle %></h2>
    <p class="lead"><%= homepage.partnersText %></p>
    <div class="pgrid">
      <% var picons = ['partnerIcon1', 'partnerIcon2', 'partnerIcon3', 'partnerIcon4']; homepage.partnerItems.forEach(function(p, i) { %>
      <div class="pi"><img class="pico" src="<%= root %><%= siteImages[picons[i % 4]] %>" alt="" loading="lazy"><h3><%= p.title %></h3><p><%= p.text %></p></div>
      <% }); %>
    </div>
    <p class="closing"><%= homepage.partnersClosing %></p>
  </div>
</section>

<% if (news.length) { %>
<section class="news-sec" id="tin-tuc-noi-bat"<%- fx('home-news') %>>
  <div class="wrap">
    <h2><%= homepage.newsTitle %></h2>
    <div class="car" data-car="auto">
      <div class="car-viewport"><div class="car-track">
        <% news.forEach(function(item) { %>
        <div class="car-item"><article class="ncard">
          <% var nl = (item.category === 'thi-truong' && item.sourceUrl) ? item.sourceUrl : (root + 'tin-tuc/' + item.slug + '.html'); var ext = nl !== root + 'tin-tuc/' + item.slug + '.html'; %>
          <a class="ni" href="<%= nl %>"<%- ext ? ' target="_blank" rel="noopener"' : '' %>><% if (item.image) { %><img src="<%= root %><%= item.image %>" alt="" loading="lazy"><% } %></a>
          <div class="nb">
            <span class="nd"><%- include('partials/icon', { name: 'calendar' }) %><%= formatDateVi(item.publishedAt) %></span>
            <h3><%= item.title %></h3>
            <p><%= item.excerpt %></p>
            <a class="btn btn-gold" href="<%= nl %>"<%- ext ? ' target="_blank" rel="noopener"' : '' %>><%= t('btn.more') %></a>
          </div>
        </article></div>
        <% }); %>
      </div></div>
      <div class="dots"></div>
    </div>
  </div>
</section>
<% } %>

<section class="cta-band"<%- fx('home-cta') %>>
  <img class="wm l" src="<%= root %><%= siteImages.watermark %>" alt="">  <img class="wm r" src="<%= root %><%= siteImages.watermark %>" alt="">  <h2><%= homepage.ctaTitle %> <span><%= homepage.ctaHighlight %></span></h2>
  <div class="rule"></div>
  <p><%= homepage.ctaText %></p>
  <a class="btn btn-yellow btn-lg" href="#thanh-vien"><%= homepage.ctaButton %></a>
</section>

<%
var mq = String(homepage.mapQuery || '').trim();
var mIf = /src=["']([^"']+)["']/.exec(mq);
var mapOk = function(u) { return u.indexOf('https://www.google.com/maps/embed') === 0; };
var mapSrc = (mIf && mapOk(mIf[1])) ? mIf[1] : (mapOk(mq) ? mq : (mq.indexOf('<') === -1 ? ('https://www.google.com/maps?q=' + encodeURIComponent(mq || footer.address) + '&t=m&z=17&hl=vi&output=embed') : 'https://www.google.com/maps?q=' + encodeURIComponent(footer.address) + '&t=m&z=17&hl=vi&output=embed'));
%>
<div class="map-wrap"<%- fx('home-map') %>><iframe title="<%= t('home.map') %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen src="<%= mapSrc %>"></iframe></div>
</main>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion, fx: fx }) %>
</body></html>

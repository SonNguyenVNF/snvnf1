<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: 'Synetic Group — Kiến tạo giá trị vượt trội', desc: homepage.introText, root: root, assetVersion: assetVersion, siteImages: siteImages, fxStyle: fxStyle, fontCss: fontCss }) %></head>
<body class="t-blue">
<%- include('partials/header', { root: root, active: 'home', siteImages: siteImages }) %>
<%
function highlightDesc(d) { d = d || ''; return d.indexOf('**') === -1 ? d.replace('đổi mới, kết nối và phát triển bền vững', '**đổi mới, kết nối và phát triển bền vững**') : d; }
var slides = heroSlides.length ? heroSlides : [{ image: siteImages.banner, title: 'KIẾN TẠO GIÁ TRỊ **VƯỢT TRỘI**', description: homepage.introText }];
%>
<main id="top">
<section class="hero" data-once="<%= homepage.heroAnimEvery === '0' ? '1' : '0' %>" data-interval="<%= homepage.heroSlideSeconds %>" style="--w-dur:<%= homepage.heroWordDuration %>s;--w-gap:<%= homepage.heroWordGap %>s;--w-start:<%= homepage.heroStartDelay %>s">
  <% slides.forEach(function(slide, i) { %><div class="hslide<%= i === 0 ? ' active' : '' %>" style="background-image:url('<%= root %><%= slide.image %>')"></div>
  <% }); %>
  <% slides.forEach(function(slide, i) { %>
  <div class="hero-text<%= i === 0 ? ' active' : '' %>" style="--pd:<%= ((slide.title || '').replace(/\*\*/g, '').trim().split(/\s+/).length * parseFloat(homepage.heroWordGap) + parseFloat(homepage.heroStartDelay) + parseFloat(homepage.heroWordDuration) * 0.7).toFixed(2) %>s">
    <h1><%- renderHeroWords(slide.title) %></h1>
    <% if (slide.description) { %><p><%- renderHeroTitle(highlightDesc(slide.description)) %></p><% } %>
    <div class="hero-cta">
      <a class="btn btn-yellow" href="#thanh-vien"><%= homepage.heroBtn1 %></a>
      <a class="btn btn-outline" href="<%= root %>ve-chung-toi.html"><%= homepage.heroBtn2 %></a>
    </div>
  </div>
  <% }); %>
  <% if (slides.length > 1) { %>
  <button class="hero-arrow hero-prev" type="button" aria-label="Slide trước">‹</button>
  <button class="hero-arrow hero-next" type="button" aria-label="Slide sau">›</button>
  <div class="hero-dots"></div>
  <% } %>
</section>

<section class="intro" id="gioi-thieu"<%- fx('home-intro') %>>
  <div class="wrap">
    <div>
      <h2><%= homepage.introTitle %></h2>
      <h3><%= homepage.introSubtitle %></h3>
      <div class="rule"></div>
      <p><%= homepage.introText %></p>
      <a class="btn btn-gold btn-lg" href="<%= root %>ve-chung-toi.html"><%= homepage.introButton %></a>
    </div>
    <div class="frame"><img src="<%= root %><%= siteImages.intro %>" alt="<%= homepage.introTitle %>"></div>
  </div>
  <img class="pent-deco" src="<%= root %>assets/img/pentagon.svg" alt="">
</section>

<section class="members" id="thanh-vien"<%- fx('home-members') %>>
  <div class="wrap">
    <h2 class="t-h"><%= homepage.membersTitle %></h2>
    <div class="mgrid">
      <% members.forEach(function(m) { %>
      <a class="mcard" href="<%= root %>thanh-vien/<%= m.slug %>.html">
        <span class="ml"><img src="<%= root %><%= m.logo || 'assets/img/logo-white.png' %>" alt="<%= m.name %>" loading="lazy"></span>
        <span class="mn"><%= m.brand %></span>
        <span class="ms"><%= m.brandSub %></span>
        <span class="mt"><%= tagBreak(m.tagline) %></span>
        <span class="btn btn-yellow">Tìm hiểu thêm</span>
      </a>
      <% }); %>
    </div>
  </div>
</section>

<section class="partners-band"<%- fx('home-partners') %>>
  <img class="wm l" src="<%= root %>assets/img/pentagon-wm.svg" alt="">
  <img class="wm r" src="<%= root %>assets/img/pentagon-wm.svg" alt="">
  <div class="wrap">
    <h2><%= homepage.partnersTitle %></h2>
    <p class="lead"><%= homepage.partnersText %></p>
    <div class="pgrid">
      <% var picons = ['b_farm', 'b_hub', 'b_truck', 'b_money']; homepage.partnerItems.forEach(function(p, i) { %>
      <div class="pi"><%- include('partials/icon', { name: picons[i % 4] }) %><h3><%= p.title %></h3><p><%= p.text %></p></div>
      <% }); %>
    </div>
    <p class="closing"><%= homepage.partnersClosing %></p>
  </div>
</section>

<% if (news.length) { %>
<section class="news-sec" id="tin-tuc-noi-bat"<%- fx('home-news') %>>
  <div class="wrap">
    <h2><%= homepage.newsTitle %></h2>
    <div class="car" data-car="auto">
      <div class="car-viewport"><div class="car-track">
        <% news.forEach(function(item) { %>
        <div class="car-item"><article class="ncard">
          <a class="ni" href="<%= root %>tin-tuc/<%= item.slug %>.html"><% if (item.image) { %><img src="<%= root %><%= item.image %>" alt="" loading="lazy"><% } %></a>
          <div class="nb">
            <span class="nd"><%- include('partials/icon', { name: 'calendar' }) %><%= formatDateVi(item.publishedAt) %></span>
            <h3><%= item.title %></h3>
            <p><%= item.excerpt %></p>
            <a class="btn btn-gold" href="<%= root %>tin-tuc/<%= item.slug %>.html">Xem thêm</a>
          </div>
        </article></div>
        <% }); %>
      </div></div>
      <div class="dots"></div>
    </div>
  </div>
</section>
<% } %>

<section class="cta-band"<%- fx('home-cta') %>>
  <img class="wm l" src="<%= root %>assets/img/pentagon-wm.svg" alt="">
  <img class="wm r" src="<%= root %>assets/img/pentagon-wm.svg" alt="">
  <h2><%= homepage.ctaTitle %> <span><%= homepage.ctaHighlight %></span></h2>
  <div class="rule"></div>
  <p><%= homepage.ctaText %></p>
  <a class="btn btn-white" href="#thanh-vien"><%= homepage.ctaButton %></a>
</section>

<img class="map-img"<%- fx('home-map') %> src="<%= root %><%= siteImages.map %>" alt="Bản đồ trụ sở Synetic Group" loading="lazy">
</main>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion, fx: fx }) %>
</body></html>

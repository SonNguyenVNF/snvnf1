<form class="<%= formClass %>" method="POST" action="/lien-he" autocomplete="on">
  <input type="hidden" name="back" value="<%= back %>">
  <input class="hp" type="text" name="company_site" tabindex="-1" autocomplete="off" aria-hidden="true">
  <% if (contactStatus === 'ok') { %><div class="ft-msg ok full"><%= t('form.ok') %></div>
  <% } else if (contactStatus === 'err') { %><div class="ft-msg err full"><%= t('form.err') %></div>
  <% } else if (contactStatus === 'limit') { %><div class="ft-msg err full"><%= t('form.limit') %></div><% } %>
  <% if (formClass === 'pd-form') { %>
  <input type="text" name="name" maxlength="120" placeholder="<%= t('pd.ph.name') %>" required aria-label="<%= t('pd.ph.name') %>">
  <input type="tel" name="phone" maxlength="40" placeholder="<%= t('pd.ph.phone') %>" required aria-label="<%= t('pd.ph.phone') %>">
  <textarea class="full" name="message" maxlength="3000" required placeholder="<%= t('pd.ph.message') %>" aria-label="<%= t('pd.ph.message') %>"></textarea>
  <div class="sub"><button class="btn btn-navy" type="submit"><%= t('btn.send') %></button></div>
  <% } else { %>
  <input class="full" type="text" name="name" maxlength="120" placeholder="<%= t('ft.ph.name') %>" required aria-label="<%= t('ft.ph.name') %>">
  <input type="tel" name="phone" maxlength="40" placeholder="<%= t('ft.ph.phone') %>" aria-label="<%= t('ft.ph.phone') %>">
  <input type="email" name="email" maxlength="120" placeholder="<%= t('ft.ph.email') %>" aria-label="<%= t('ft.ph.email') %>">
  <textarea class="full" name="message" maxlength="3000" required placeholder="<%= t('ft.ph.message') %>" aria-label="<%= t('ft.ph.message') %>"></textarea>
  <button class="btn btn-yellow" type="submit"><%= t('btn.send') %></button>
  <% } %>
</form>

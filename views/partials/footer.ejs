<footer class="ft" id="lien-he"<%- typeof fx === 'function' ? fx('footer') : '' %><% if (siteImages.footerBg) { %> style="background-image:url('<%= root %><%= siteImages.footerBg %>')"<% } %>>
<div class="wrap">
  <div>
    <a class="ft-logo" href="<%= root %>index.html"><img src="<%= root %><%= siteImages.logo %>" alt="Synetic Group"></a>
    <h3><%= footer.companyName %></h3>
    <ul class="ft-contact">
      <li><span class="ci"><%- include('icon', { name: 'pin' }) %></span><span><small>Địa chỉ trụ sở</small><%= footer.address %></span></li>
      <li><span class="ci"><%- include('icon', { name: 'mail' }) %></span><span><%= footer.email %></span></li>
      <li><span class="ci"><%- include('icon', { name: 'phone' }) %></span><span><%= footer.phone %></span></li>
      <% if (footer.website) { %><li><span class="ci"><%- include('icon', { name: 'globe' }) %></span><span><%= footer.website %></span></li><% } %>
    </ul>
    <div class="ft-social">
      <% if (footer.facebook) { %><a href="<%= footer.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><%- include('icon', { name: 'fb' }) %></a><% } %>
      <% if (footer.tiktok) { %><a href="<%= footer.tiktok %>" target="_blank" rel="noopener" aria-label="TikTok"><%- include('icon', { name: 'tiktok' }) %></a><% } %>
      <% if (footer.messenger) { %><a href="<%= footer.messenger %>" target="_blank" rel="noopener" aria-label="Messenger"><%- include('icon', { name: 'messenger' }) %></a><% } %>
      <% if (footer.zalo) { %><a href="<%= footer.zalo %>" target="_blank" rel="noopener" aria-label="Zalo"><span class="zl">Zalo</span></a><% } %>
    </div>
  </div>
  <div>
    <div class="ft-links">
      <ul><li><a href="<%= root %>index.html">Trang chủ</a></li><li><a href="<%= root %>ve-chung-toi.html">Về chúng tôi</a></li></ul>
      <ul><li><a href="<%= root %>index.html#thanh-vien">Hệ sinh thái</a></li><li><a href="<%= root %>tin-tuc.html">Tin tức</a></li></ul>
      <ul><li><a href="<%= root %>tuyen-dung.html">Tuyển dụng</a></li><li><a href="#lien-he">Liên hệ</a></li></ul>
    </div>
    <%- include('contact-form', { root: root, formClass: 'ft-form', contactStatus: contactStatus, back: back }) %>
  </div>
</div>
</footer>
<div class="copy"><span><%= footer.copyright %></span><button class="to-top" id="fabTop" type="button" aria-label="Lên đầu trang"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 15 12 9 18 15"/></svg></button></div>
<script src="<%= root %>assets/nav.js?v=<%= assetVersion %>" defer></script>

<footer class="ft" id="lien-he"<%- typeof fx === 'function' ? fx('footer') : '' %><% if (siteImages.footerBg) { %> style="background-image:url('<%= root %><%= siteImages.footerBg %>')"<% } %>>
<div class="wrap">
  <div>
    <a class="ft-logo" href="<%= root %>index.html"><img src="<%= root %><%= siteImages.logo %>" alt="<%= t('logo.alt') %>"></a>
    <h3><%= footer.companyName %></h3>
    <ul class="ft-contact">
      <li><span class="ci"><%- include('icon', { name: 'pin' }) %></span><span><small><%= t('footer.addr') %></small><%= footer.address %></span></li>
      <li><span class="ci"><%- include('icon', { name: 'mail' }) %></span><span><%= footer.email %></span></li>
      <li><span class="ci"><%- include('icon', { name: 'phone' }) %></span><span><%= footer.phone %></span></li>
      <% if (footer.website) { %><li><span class="ci"><%- include('icon', { name: 'globe' }) %></span><span><%= footer.website %></span></li><% } %>
    </ul>
    <% var soc = [['facebook', 'Facebook', 'fb'], ['tiktok', 'TikTok', 'tiktok'], ['messenger', 'Messenger', 'messenger'], ['zalo', 'Zalo', '']]; %>
    <div class="ft-social">
      <% soc.forEach(function(s) { var u = footer[s[0]] || '#'; %><a <% if (u !== '#') { %>href="<%= u %>" target="_blank" rel="noopener"<% } else { %>class="no-link" role="presentation" tabindex="-1" onclick="return false"<% } %> aria-label="<%= s[1] %>"><% if (s[2]) { %><%- include('icon', { name: s[2] }) %><% } else { %><span class="zl">Zalo</span><% } %></a>
      <% }); %>
    </div>
  </div>
  <div>
    <div class="ft-links">
      <ul><li><a href="<%= root %>index.html"><%= t('foot.home') %></a></li><li><a href="<%= root %>ve-chung-toi.html"><%= t('foot.about') %></a></li></ul>
      <ul><li><a href="<%= root %>index.html#thanh-vien"><%= t('foot.eco') %></a></li><li><a href="<%= root %>tin-tuc.html"><%= t('foot.news') %></a></li></ul>
      <ul><li><a href="<%= root %>tuyen-dung.html"><%= t('foot.jobs') %></a></li><li><a href="#lien-he"><%= t('foot.contact') %></a></li></ul>
    </div>
    <%- include('contact-form', { root: root, formClass: 'ft-form', contactStatus: contactStatus, back: back }) %>
  </div>
</div>
</footer>
<div class="copy"><span><%= footer.copyright %></span><button class="to-top" id="fabTop" type="button" aria-label="<%= t('aria.totop') %>"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 15 12 9 18 15"/></svg></button></div>
<script>window.SYN_T=<%- JSON.stringify(clientTexts()).replace(/</g, "\u003c") %></script>
<script src="<%= root %>assets/nav.js?v=<%= assetVersion %>" defer></script>

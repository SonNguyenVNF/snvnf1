<footer id="lien-he"><div class="wrap">
  <div class="fg">
    <div>
      <div class="fb"><img class="footer-logo" src="<%= root %><%= siteImages.logo %>" alt="Synetic Group"></div>
      <p><%= footer.companyName %><br><%= footer.address %><br>MST: <%= footer.taxCode %></p>
      <p style="margin-top:12px">T <%= footer.phone %> · <a href="mailto:<%= footer.email %>"><%= footer.email %></a></p>
    </div>
    <div><h5>THÀNH VIÊN</h5><ul><% members.forEach(function(m) { %><li><a href="<%= root %>thanh-vien/<%= m.slug %>.html"><%= m.name %></a></li><% }); %></ul></div>
    <div><h5>HỖ TRỢ</h5><ul>
      <li><a href="<%= active === 'home' ? '#lien-he' : root + 'index.html#lien-he' %>">Câu hỏi thường gặp</a></li>
      <li><a href="<%= active === 'home' ? '#lien-he' : root + 'index.html#lien-he' %>">Chính sách bảo mật</a></li>
      <li><a href="<%= active === 'home' ? '#lien-he' : root + 'index.html#lien-he' %>">Điều khoản sử dụng</a></li>
      <li><a href="<%= root %>tuyen-dung.html">Tuyển dụng</a></li></ul></div>
  </div>
  <div class="fbot"><span class="fsl"><%= footer.tagline %></span>
    <span>© <%= new Date().getFullYear() %> <%= footer.companyName %>. Bảo lưu mọi quyền.</span></div>
</div></footer>

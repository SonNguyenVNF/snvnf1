<aside class="j-side">
  <a class="btn-find" href="<%= root %>tuyen-dung.html"><%= t('btn.findjob') %></a>
  <% if (asForm) { %><form method="get" action="<%= root %>tuyen-dung.html"><% } %>
  <div class="grp">
    <h4><%= t('job.dept') %></h4>
    <div class="sb"><input type="text" data-optsearch aria-label="<%= t('job.deptsearch') %>"><%- include('icon', { name: 'search' }) %></div>
    <% departments.forEach(function(d) { %><label><input type="checkbox" <%- asForm ? 'name="dept" onchange="this.form.submit()"' : 'data-filter="dept"' %> value="<%= d %>"><%= d %></label>
    <% }); %>
  </div>
  <div class="grp">
    <h4><%= t('job.loc') %></h4>
    <div class="sb"><input type="text" data-optsearch aria-label="<%= t('job.locsearch') %>"><%- include('icon', { name: 'search' }) %></div>
    <% locations.forEach(function(l) { %><label><input type="checkbox" <%- asForm ? 'name="loc" onchange="this.form.submit()"' : 'data-filter="loc"' %> value="<%= l %>"><%= l %></label>
    <% }); %>
  </div>
  <% if (asForm) { %></form><% } %>
</aside>

<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: item.name + t('title.suffix'), desc: item.name + ' — ' + item.tagline + '. ' + t('desc.member'), root: root, assetVersion: assetVersion, siteImages: siteImages, fxStyle: fxStyle, fontCss: fontCss }) %></head>
<body class="t-<%= theme %>">
<%- include('partials/header', { root: root, active: 'eco', siteImages: siteImages }) %>
<%- include('partials/banner', { root: root, title: '', siteImages: siteImages }) %>

<main>
<section class="m-main"<%- fx('member-main') %>><div class="wrap m-grid">
  <div>
    <h1><%= item.pageTitle || item.name %></h1>
    <p class="slogan"><%= item.tagline %></p>
    <div class="body">
      <% (item.body || '').replace(/\r\n/g, '\n').split(/\n{2,}/).forEach(function(paragraph) { %><% if (paragraph.trim()) { %><p><%= paragraph.trim() %></p>
      <% } %><% }); %>
    </div>
  </div>
  <% if (facts.length) { %>
  <div class="m-info">
    <h2><%= item.factsTitle || t('member.facts') %></h2>
    <% facts.forEach(function(f) { %>
    <div class="icard">
      <% if (f.image) { %><div class="ii"><img src="<%= root %><%= f.image %>" alt="" loading="lazy"></div><% } %>
      <div><h4><%= f.label %></h4><p><%= f.value %></p></div>
    </div>
    <% }); %>
  </div>
  <% } %>
</div></section>

<% var hasUnits = item.units && item.units.length; %>
<% if (hasUnits) { %>
<section class="m-band m-units"<%- fx('member-others') %>>
  <img class="wm l" src="<%= root %><%= siteImages.watermark %>" alt="">  <img class="wm r" src="<%= root %><%= siteImages.watermark %>" alt="">  <div class="wrap">
    <h2 class="t-h"><%= item.unitsTitle %></h2>
    <div class="ugrid">
      <% item.units.forEach(function(u) { %>
      <div class="ucard">
        <span class="ul"><% if (u.logo) { %><img src="<%= root %><%= u.logo %>" alt="<%= u.name %>" loading="lazy"><% } %></span>
        <span class="un"><%= u.name %></span>
        <% if (u.url) { %><a class="btn btn-blue" href="<%= u.url %>"><%= t('btn.learn') %></a><% } else { %><span class="btn btn-blue no-link"><%= t('btn.learn') %></span><% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } else if (allMembers.length) { %>
<section class="m-band"<%- fx('member-others') %>>
  <img class="wm l" src="<%= root %><%= siteImages.watermark %>" alt="">  <img class="wm r" src="<%= root %><%= siteImages.watermark %>" alt="">  <div class="wrap">
    <h2 class="t-h"><%= homepage.membersTitle %></h2>
    <div class="mgrid" style="--n:<%= Math.min(allMembers.length, 5) %>">
      <% allMembers.forEach(function(m) { %>
      <a class="mcard" href="<%= root %>thanh-vien/<%= m.slug %>.html">
        <span class="ml"><img src="<%= root %><%= m.logo %>" alt="<%= m.name %>" loading="lazy" onerror="this.onerror=null;this.src='<%= root %>assets/img/logo-m-<%= m.slug %>.png'"></span>
        <span class="mt"><%= cardQuote(m.tagline) %></span>
        <span class="btn btn-blue"><%= t('btn.learn') %></span>
      </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="cta-band"<%- fx('member-cta') %>>
  <img class="wm l" src="<%= root %><%= siteImages.watermark %>" alt="">  <img class="wm r" src="<%= root %><%= siteImages.watermark %>" alt="">  <h2><%= homepage.ctaTitle %> <span><%= homepage.ctaHighlight %></span></h2>
  <div class="rule"></div>
  <p><%= homepage.ctaText %></p>
  <a class="btn btn-yellow btn-lg" href="<%= root %>index.html#thanh-vien"><%= t('btn.explore') %></a>
</section>
</main>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion, fx: fx }) %>
</body></html>

<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: item.name + ' — Synetic Group', desc: item.name + ' — ' + item.tagline + '. Thành viên hệ sinh thái Synetic Group.', root: root, assetVersion: assetVersion, siteImages: siteImages }) %></head>
<body class="t-<%= theme %>">
<%- include('partials/header', { root: root, active: 'eco', siteImages: siteImages }) %>
<%- include('partials/banner', { root: root, title: '', siteImages: siteImages }) %>

<main>
<section class="m-main"><div class="wrap m-grid">
  <div>
    <h1><%= item.name %></h1>
    <p class="slogan"><%= item.tagline %></p>
    <div class="body">
      <% (item.body || '').replace(/\r\n/g, '\n').split(/\n{2,}/).forEach(function(paragraph) { %><% if (paragraph.trim()) { %><p><%= paragraph.trim() %></p>
      <% } %><% }); %>
    </div>
  </div>
  <% if (facts.length) { %>
  <div class="m-info">
    <h2><%= item.factsTitle || 'THÔNG TIN NHANH' %></h2>
    <% facts.forEach(function(f) { %>
    <div class="icard">
      <% if (f.image) { %><div class="ii"><img src="<%= root %><%= f.image %>" alt="" loading="lazy"></div><% } %>
      <div><h4><%= f.label %></h4><p><%= f.value %></p></div>
    </div>
    <% }); %>
  </div>
  <% } %>
</div></section>

<% if (otherMembers.length) { %>
<section class="m-band">
  <div class="wrap">
    <h2 class="t-h">CÁC THÀNH VIÊN KHÁC TRONG HỆ SINH THÁI</h2>
    <div class="mgrid" style="--n:<%= Math.min(otherMembers.length, 5) %>">
      <% otherMembers.forEach(function(m) { %>
      <a class="mcard" href="<%= root %>thanh-vien/<%= m.slug %>.html">
        <span class="ml"><img src="<%= root %><%= m.logo || 'assets/img/logo-white.png' %>" alt="<%= m.name %>" loading="lazy"></span>
        <span class="mn"><%= m.brand %></span>
        <span class="ms"><%= m.brandSub %></span>
        <span class="mt"><%= tagBreak(m.tagline) %></span>
        <span class="btn btn-yellow">Tìm hiểu thêm</span>
      </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="cta-band<%= theme === 'gold' ? ' green' : '' %>">
  <img class="wm l" src="<%= root %>assets/img/pentagon-wm.svg" alt="">
  <img class="wm r" src="<%= root %>assets/img/pentagon-wm.svg" alt="">
  <h2><%= homepage.ctaTitle %> <span><%= homepage.ctaHighlight %></span></h2>
  <div class="rule"></div>
  <p><%= homepage.ctaText %></p>
  <a class="btn btn-white" href="<%= root %>ve-chung-toi.html">Tìm hiểu thêm</a>
</section>
</main>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion }) %>
</body></html>

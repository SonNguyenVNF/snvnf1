<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= item.name %> — Synetic Group</title>
<meta name="description" content="<%= item.name %> — <%= item.tagline %>. Thành viên hệ sinh thái Synetic Group.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="<%= root %>assets/style.css?v=<%= assetVersion %>" rel="stylesheet">
<style>:root{--logo-h:<%= siteImages.logoHeight || 52 %>px;--logo-h-mobile:<%= siteImages.logoHeightMobile || 58 %>px}</style>
</head><body class="m-<%= item.accent || 'emerald' %>">

<header><div class="wrap nav">
  <a class="brand" href="<%= root %>index.html"><img class="brand-logo" src="<%= root %><%= siteImages.logo %>" alt="Synetic Group"></a>
  <nav><ul>
    <li><a class="nav-home" href="<%= root %>index.html"><span class="hico" aria-hidden="true">⌂</span> Trang chủ</a></li>
    <li class="has-dropdown">
      <button class="dropdown-toggle" type="button">Về Synetic <span class="car">▾</span></button>
      <div class="dropdown">
        <a href="<%= root %>ve-synetic/thong-diep-chu-tich-hdqt.html">Thông điệp Chủ tịch HĐQT</a>
        <a href="<%= root %>ve-synetic/thong-diep-tong-giam-doc.html">Thông điệp Tổng giám đốc</a>
        <a href="<%= root %>ve-synetic/gia-tri-cot-loi.html">Giá trị cốt lõi</a>
        <a href="<%= root %>ve-synetic/lich-su.html">Lịch sử</a>
        <a href="<%= root %>ve-synetic/tam-nhin-chien-luoc.html">Tầm nhìn chiến lược</a>
        <a href="<%= root %>ve-synetic/mang-luoi-hoat-dong.html">Mạng lưới hoạt động</a>
        <a href="<%= root %>ve-synetic/doi-ngu-lanh-dao.html">Đội ngũ lãnh đạo</a>
        <a href="<%= root %>ve-synetic/trach-nhiem-xa-hoi.html">Trách nhiệm xã hội</a>
        <a href="<%= root %>ve-synetic/giai-thuong.html">Giải thưởng</a>
        <a href="<%= root %>ve-synetic/doi-tac-khach-hang.html">Đối tác và khách hàng</a>
      </div>
    </li>
    <li><a href="<%= root %>index.html#thanh-vien">Hệ sinh thái</a></li>
    <li><a href="<%= root %>du-an.html">Dự án</a></li>
    <li><a href="<%= root %>tin-tuc.html">Tin tức</a></li>
    <li><a href="<%= root %>ve-synetic/doi-tac-khach-hang.html">Đối tác</a></li>
    <li><a href="<%= root %>tuyen-dung.html">Cơ hội việc làm</a></li>
  </ul></nav>
  <a class="btn" href="<%= root %>index.html#lien-he">Liên hệ ngay</a>
  <div class="nav-icons">
    <div class="has-dropdown lang-switch">
      <button class="dropdown-toggle" type="button" aria-label="Chọn ngôn ngữ">VI</button>
      <div class="dropdown lang-dropdown">
        <span class="lang-item current">🇻🇳 Tiếng Việt</span>
        <span class="lang-item disabled">🇬🇧 English <i>(sắp ra mắt)</i></span>
      </div>
    </div>
  </div>
  <button class="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false"><span></span><span></span><span></span></button>
</div></header>

<main>
<div class="abar wrap"><a href="<%= root %>index.html">← Về trang chủ</a> &nbsp;/&nbsp; Thành viên &nbsp;/&nbsp; <%= item.name %></div>

<section class="ahero"><div class="wrap">
  <p class="k">THÀNH VIÊN HỆ SINH THÁI</p>
  <h1><%= item.name %></h1>
  <p class="slogan"><%= item.tagline %></p>
  <p class="legal"><%= item.legalName %></p>
</div></section>

<section class="abody"><div class="wrap grid">
  <div class="art">
    <% (item.body || '').split(/\n{2,}/).forEach(function(paragraph) { %>
      <% if (paragraph.trim()) { %><p><%= paragraph.trim() %></p><% } %>
    <% }); %>
  </div>
  <% if (item.facts && item.facts.length) { %>
  <div class="afacts">
    <% if (item.factsTitle) { %><p class="k"><%= item.factsTitle %></p><% } %>
    <dl>
      <% item.facts.forEach(function(f) { %><div class="row"><dt><%= f.label %></dt><dd><%= f.value %></dd></div><% }); %>
    </dl>
  </div>
  <% } %>
</div></section>

<% if (otherMembers.length) { %>
<section class="arel"><div class="wrap">
  <h3>Các thành viên khác</h3>
  <div class="row">
    <% otherMembers.forEach(function(o) { %><a href="<%= root %>thanh-vien/<%= o.slug %>.html"><%= o.name %><span><%= o.tagline %></span></a><% }); %>
  </div>
</div></section>
<% } %>
</main>

<footer id="lien-he"><div class="wrap">
  <div class="fg">
    <div>
      <div class="fb"><img class="footer-logo" src="<%= root %><%= siteImages.logo %>" alt="Synetic Group"></div>
      <p><%= footer.companyName %><br><%= footer.address %><br>MST: <%= footer.taxCode %></p>
      <p style="margin-top:12px">T <%= footer.phone %> · <a href="mailto:<%= footer.email %>"><%= footer.email %></a></p>
    </div>
    <div><h5>THÀNH VIÊN</h5><ul><% members.forEach(function(m) { %><li><a href="<%= root %>thanh-vien/<%= m.slug %>.html"><%= m.name %></a></li><% }); %></ul></div>
    <div><h5>HỖ TRỢ</h5><ul>
      <li><a href="<%= root %>index.html#lien-he">Câu hỏi thường gặp</a></li>
      <li><a href="<%= root %>index.html#lien-he">Chính sách bảo mật</a></li>
      <li><a href="<%= root %>index.html#lien-he">Điều khoản sử dụng</a></li>
      <li><a href="<%= root %>tuyen-dung.html">Tuyển dụng</a></li></ul></div>
  </div>
  <div class="fbot"><span class="fsl"><%= footer.tagline %></span>
    <span>© <%= new Date().getFullYear() %> <%= footer.companyName %>. Bảo lưu mọi quyền.</span></div>
</div></footer>
<%- include('partials/ticker', { root: root, ticker: ticker }) %>
<div class="fab-stack" id="fabStack">
  <a class="fab-btn" href="#" target="_blank" rel="noopener" aria-label="Chat qua Zalo">
    <svg viewBox="0 0 48 48" width="26" height="26" aria-hidden="true"><rect x="4" y="4" width="40" height="40" rx="11" fill="#0068FF"/><path d="M12 16.5a4 4 0 0 1 4-4h16a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4h-9.3l-5.9 4.4c-.7.5-1.8 0-1.8-.9V16.5Z" fill="#fff"/><text x="24" y="24.8" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-style="italic" font-size="10.5" fill="#0068FF">Zalo</text></svg>
  </a>
  <a class="fab-btn" href="mailto:<%= footer.email %>" aria-label="Gửi email">
    <svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true"><rect x="2" y="4.5" width="20" height="15" rx="2" fill="#fff" stroke="#EA4335" stroke-width="1.6"/><path d="M3 5.5l9 7 9-7" fill="none" stroke="#EA4335" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
  <a class="fab-btn" href="#" target="_blank" rel="noopener" aria-label="Chat qua Messenger">
    <svg viewBox="0 0 48 48" width="28" height="28" aria-hidden="true">
      <defs><linearGradient id="mg" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#00C6FF"/><stop offset=".5" stop-color="#8B3DFF"/><stop offset="1" stop-color="#FF5CA8"/></linearGradient></defs>
      <path d="M24 4C12.4 4 4 12.1 4 23.1c0 6.1 2.7 11.5 7 15.1-.3 1.7-1.5 5.5-1.7 6.3-.2.8.2 1 .8.7.4-.2 5.2-3.6 7.2-5 2.2.6 4.5.9 6.7.9 11.6 0 20-8.1 20-19S35.6 4 24 4Z" fill="url(#mg)"/>
      <path d="M13.5 27.3 20.7 19.6l5.1 4.9 7-4.9-7.3 7.8-5-4.9-6.9 4.8Z" fill="#fff"/>
    </svg>
  </a>
  <button class="fab-btn fab-top" id="fabTop" type="button" aria-label="Lên đầu trang">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 15 12 9 18 15"/></svg>
  </button>
</div>
<script src="<%= root %>assets/nav.js?v=<%= assetVersion %>" defer></script>
</body></html>

<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: item.title + ' — Synetic Group', desc: item.excerpt, root: root, assetVersion: assetVersion, siteImages: siteImages, fxStyle: fxStyle }) %></head>
<body class="t-blue">
<%- include('partials/header', { root: root, active: 'tin-tuc', siteImages: siteImages }) %>
<%- include('partials/banner', { root: root, title: 'TIN TỨC', siteImages: siteImages }) %>

<main class="n-main"><div class="wrap">
  <div class="a-head"><h1><%= item.title %></h1></div>
  <div class="a-date"><%- include('partials/icon', { name: 'calendar' }) %><%= formatDateVi(item.publishedAt) %></div>
  <div class="a-body"<%- fx('news-detail') %>>
    <% if (item.image && !blocks.some(function(b) { return b.src === item.image; })) { %><img src="<%= root %><%= item.image %>" alt=""><% } %>
    <% blocks.forEach(function(b) { %><% if (b.type === 'img') { %><img src="<%= root %><%= b.src %>" alt="" loading="lazy">
    <% } else { %><p><%- renderInline(b.text) %></p>
    <% } %><% }); %>
  </div>

  <% if (related.length) { %>
  <div class="related"<%- fx('news-related') %>>
    <h2 class="h-line">BÀI VIẾT LIÊN QUAN</h2>
    <% related.forEach(function(it) { %>
    <article class="n-row">
      <a class="ni" href="<%= root %>tin-tuc/<%= it.slug %>.html"><% if (it.image) { %><img src="<%= root %><%= it.image %>" alt="" loading="lazy"><% } %></a>
      <div class="t">
        <h3><a href="<%= root %>tin-tuc/<%= it.slug %>.html"><%= it.title %></a></h3>
        <span class="nd"><%- include('partials/icon', { name: 'calendar' }) %><%= formatDateVi(it.publishedAt) %></span>
        <p class="ex"><%= it.excerpt %></p>
        <a class="btn btn-gold" href="<%= root %>tin-tuc/<%= it.slug %>.html">Xem thêm</a>
      </div>
    </article>
    <% }); %>
  </div>
  <% } %>
</div></main>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion, fx: fx }) %>
</body></html>

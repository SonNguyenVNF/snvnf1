<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: item.title + t('title.suffix'), desc: item.excerpt, root: root, assetVersion: assetVersion, siteImages: siteImages, fxStyle: fxStyle, fontCss: fontCss }) %></head>
<body class="t-blue">
<%- include('partials/header', { root: root, active: 'tin-tuc', siteImages: siteImages }) %>
<%- include('partials/banner', { root: root, title: t('banner.news'), siteImages: siteImages }) %>

<main class="n-main"><div class="wrap">
  <div class="a-head"><h1><%= item.title %></h1></div>
  <div class="a-date"><%- include('partials/icon', { name: 'calendar' }) %><%= formatDateVi(item.publishedAt) %></div>
  <%
  var lastP = -1; blocks.forEach(function(b, i) { if (b.type === 'p') lastP = i; });
  var gal = []; blocks.forEach(function(b, i) { if (b.type === 'img' && i > lastP) gal.push(b.src); });
  var inlineBlocks = blocks.filter(function(b, i) { return !(b.type === 'img' && i > lastP); });
  if (item.image && gal.indexOf(item.image) === -1 && !blocks.some(function(b) { return b.src === item.image; })) gal.unshift(item.image);
  %>
  <div class="a-body"<%- fx('news-detail') %>>
    <% inlineBlocks.forEach(function(b) { %><% if (b.type === 'img') { %><img src="<%= root %><%= b.src %>" alt="" loading="lazy">
    <% } else { %><p><%- renderInline(b.text) %></p>
    <% } %><% }); %>
  </div>
  <% if (gal.length) { %>
  <div class="a-gal" data-gal>
    <div class="pm-big"><img src="<%= root %><%= gal[0] %>" alt=""><% if (item.galleryCaption) { %><span class="cap"><%= item.galleryCaption %></span><% } %></div>
    <% if (gal.length > 1) { %><div class="pm-thumbs"><div class="pm-tt"><% gal.slice(1).forEach(function(s) { %><button type="button" class="pm-th"><img src="<%= root %><%= s %>" alt=""></button><% }); %></div></div><% } %>
  </div>
  <% } %>

  <% if (related.length) { %>
  <div class="related"<%- fx('news-related') %>>
    <h2 class="h-line"><%= t('news.related') %></h2>
    <% related.forEach(function(it) { %>
    <article class="n-row">
      <a class="ni" href="<%= root %>tin-tuc/<%= it.slug %>.html"><% if (it.image) { %><img src="<%= root %><%= it.image %>" alt="" loading="lazy"><% } %></a>
      <div class="t">
        <h3><a href="<%= root %>tin-tuc/<%= it.slug %>.html"><%= it.title %></a></h3>
        <span class="nd"><%- include('partials/icon', { name: 'calendar' }) %><%= formatDateVi(it.publishedAt) %></span>
        <p class="ex"><%= it.excerpt %></p>
        <a class="btn btn-gold" href="<%= root %>tin-tuc/<%= it.slug %>.html"><%= t('btn.more') %></a>
      </div>
    </article>
    <% }); %>
  </div>
  <% } %>
</div></main>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion, fx: fx }) %>
</body></html>

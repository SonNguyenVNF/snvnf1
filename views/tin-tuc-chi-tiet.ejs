<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: item.title + ' — Synetic Group', root: root, assetVersion: assetVersion, siteImages: siteImages }) %></head><body>

<%- include('partials/header', { root: root, active: 'tin-tuc' , siteImages: siteImages }) %>

<main>
<div class="abar wrap"><a href="<%= root %>tin-tuc.html">← Tất cả tin tức</a> &nbsp;/&nbsp; Tin tức</div>

<section class="ahero"><div class="wrap">
  <p class="k"><%= item.publishedAt.split('-').reverse().join('/') %></p>
  <h1><%= item.title %></h1>
</div></section>

<section class="abody"><div class="wrap">
  <% if (item.image) { %><img src="<%= root %><%= item.image %>" alt="" style="width:100%;max-width:820px;border-radius:var(--radius);margin-bottom:32px"><% } %>
  <div class="art" style="max-width:720px">
    <% blocks.forEach(function(b) { %>
      <% if (b.type === 'p') { %><p><%= b.text %></p><% } %>
      <% if (b.type === 'img') { %><img src="<%= root %><%= b.src %>" alt="" style="width:100%;border-radius:var(--radius);margin:8px 0"><% } %>
    <% }); %>
  </div>
</div></section>
</main>

<%- include('partials/footer', { root: root, active: 'tin-tuc' , siteImages: siteImages, footer: footer, members: members }) %>
<%- include('partials/ticker', { root: root, ticker: ticker }) %>
<%- include('partials/fab', { root: root, footer: footer, assetVersion: assetVersion }) %>
</body></html>

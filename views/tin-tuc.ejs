<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: t('title.news'), root: root, assetVersion: assetVersion, siteImages: siteImages, fxStyle: fxStyle, fontCss: fontCss }) %></head>
<body class="t-blue">
<%- include('partials/header', { root: root, active: 'tin-tuc', siteImages: siteImages }) %>
<%- include('partials/banner', { root: root, title: t('banner.news'), siteImages: siteImages }) %>

<%
function lk(it) { return (it.category === 'thi-truong' && it.sourceUrl) ? it.sourceUrl : root + 'tin-tuc/' + it.slug + '.html'; }
function tg(it) { return (it.category === 'thi-truong' && it.sourceUrl) ? ' target="_blank" rel="noopener"' : ''; }
%>
<main class="n-main"><div class="wrap">
  <% if (groups.length) { %>
  <h2 class="h-line"><%= t('news.market') %></h2>
  <div class="car" data-car<%- fx('news-market') %>>
    <div class="car-viewport"><div class="car-track">
      <% groups.forEach(function(g) { %>
      <div class="car-item" style="--per:1;padding:6px 4px 12px"><div class="n-feature">
        <% var big = g[0]; %>
        <article class="n-big">
          <a class="ni" href="<%= lk(big) %>"<%- tg(big) %>><% if (big.image) { %><img src="<%= root %><%= big.image %>" alt=""><% } %></a>
          <h3><a href="<%= lk(big) %>"<%- tg(big) %>><%= big.title %></a></h3>
          <span class="nd"><%- include('partials/icon', { name: 'calendar' }) %><%= formatDateVi(big.publishedAt) %></span>
          <p><%= big.excerpt %></p>
          <a class="btn btn-gold" href="<%= lk(big) %>"<%- tg(big) %>><%= t('btn.more') %></a>
        </article>
        <div class="n-stack">
          <% g.slice(1).forEach(function(it) { %>
          <article class="n-sm">
            <a class="ni" href="<%= lk(it) %>"<%- tg(it) %>><% if (it.image) { %><img src="<%= root %><%= it.image %>" alt=""><% } %></a>
            <div class="t">
              <h3><a href="<%= lk(it) %>"<%- tg(it) %>><%= it.title %></a></h3>
              <span class="nd"><%- include('partials/icon', { name: 'calendar' }) %><%= formatDateVi(it.publishedAt) %></span>
              <p><%= it.excerpt %></p>
              <a class="btn btn-gold" href="<%= lk(it) %>"<%- tg(it) %>><%= t('btn.more') %></a>
            </div>
          </article>
          <% }); %>
        </div>
      </div></div>
      <% }); %>
    </div></div>
    <div class="dots"></div>
  </div>
  <% } %>

  <% if (internal.length) { %>
  <div<%- fx('news-internal') %>>
  <h2 class="h-line<%= groups.length ? ' sec-gap' : '' %>"><%= t('news.internal') %></h2>
  <% internal.forEach(function(it) { %>
  <article class="n-row">
    <a class="ni" href="<%= lk(it) %>"<%- tg(it) %>><% if (it.image) { %><img src="<%= root %><%= it.image %>" alt="" loading="lazy"><% } %></a>
    <div class="t">
      <h3><a href="<%= lk(it) %>"<%- tg(it) %>><%= it.title %></a></h3>
      <span class="nd"><%- include('partials/icon', { name: 'calendar' }) %><%= formatDateVi(it.publishedAt) %></span>
      <p class="ex"><%= it.excerpt %></p>
      <a class="btn btn-gold" href="<%= lk(it) %>"<%- tg(it) %>><%= t('btn.more') %></a>
    </div>
  </article>
  <% }); %>
  </div>
  <% } %>

  <% if (!groups.length && !internal.length) { %><p class="empty"><%= t('news.none') %></p><% } %>
</div></main>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion, fx: fx }) %>
</body></html>

<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: 'Tin tức — Synetic Group', root: root, assetVersion: assetVersion }) %></head><body>

<%- include('partials/header', { root: root, active: 'tin-tuc' , siteImages: siteImages }) %>

<main>
<div class="abar wrap"><a href="index.html">← Về trang chủ</a> &nbsp;/&nbsp; Tin tức</div>

<section class="ahero"><div class="wrap">
  <p class="k">TIN TỨC</p>
  <h1>Tin tức</h1>
</div></section>

<section class="abody"><div class="wrap">
  <% if (items.length) { %>
  <div class="newsgrid">
    <% items.forEach(function(item) { %>
    <a class="newscard" href="<%= root %>tin-tuc/<%= item.slug %>.html">
      <% if (item.image) { %><img src="<%= root %><%= item.image %>" alt=""><% } %>
      <div class="nbody">
        <span class="ndate"><%= item.publishedAt.split('-').reverse().join('/') %></span>
        <h4><%= item.title %></h4>
        <p><%= item.excerpt %></p>
        <span class="more">ĐỌC THÊM →</span>
      </div>
    </a>
    <% }); %>
  </div>
  <% } else { %>
  <p class="newsempty">Chưa có tin tức nào. Nội dung sẽ sớm được cập nhật.</p>
  <% } %>
</div></section>
</main>

<%- include('partials/footer', { root: root, active: 'tin-tuc' , siteImages: siteImages, footer: footer, members: members }) %>
<%- include('partials/ticker', { root: root, ticker: ticker }) %>
<%- include('partials/fab', { root: root, footer: footer, assetVersion: assetVersion }) %>
</body></html>

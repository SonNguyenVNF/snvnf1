<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: item.title + ' — Synetic Group', root: root, assetVersion: assetVersion, siteImages: siteImages }) %></head>
<body class="t-blue">
<%- include('partials/header', { root: root, active: 'tuyen-dung', siteImages: siteImages }) %>
<%- include('partials/banner', { root: root, title: 'CƠ HỘI VIỆC LÀM', siteImages: siteImages }) %>

<main><div class="wrap jd-grid">
  <div>
    <h1><%= item.title %></h1>
    <% if (item.location) { %><p class="jd-addr"><%= item.location %></p><% } %>
    <div class="jd-body rich"><%- renderRich(item.body) %></div>
  </div>
  <%- include('partials/job-side', { root: root, departments: departments, locations: locations, asForm: true }) %>
</div></main>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion }) %>
</body></html>

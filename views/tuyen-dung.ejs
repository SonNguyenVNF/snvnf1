<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: 'Tuyển dụng — Synetic Group', root: root }) %></head><body>

<%- include('partials/header', { root: root, active: 'tuyen-dung' , siteImages: siteImages }) %>

<main>
<div class="abar wrap"><a href="index.html">← Về trang chủ</a> &nbsp;/&nbsp; Tuyển dụng</div>

<section class="ahero"><div class="wrap">
  <p class="k">CƠ HỘI VIỆC LÀM</p>
  <h1>Tuyển dụng</h1>
</div></section>

<section class="vals"><div class="wrap">
  <% if (items.length) { %>
  <div class="vgrid">
    <% items.forEach(function(item) { %>
    <article class="val">
      <% if (item.image) { %><img src="<%= root %><%= item.image %>" alt="" style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:8px;margin-bottom:16px"><% } %>
      <h4><%= item.title %></h4>
      <p style="color:var(--gd);font-weight:600;font-size:12.5px;margin-bottom:8px">
        <%= [item.department, item.location, item.type].filter(Boolean).join(' · ') %>
      </p>
      <p><%= item.description %></p>
      <% if (item.deadline) { %><p style="margin-top:10px;font-size:12px;color:var(--muted)">Hạn nộp hồ sơ: <%= item.deadline.split('-').reverse().join('/') %></p><% } %>
    </article>
    <% }); %>
  </div>
  <% } else { %>
  <p class="newsempty">Hiện chưa có vị trí tuyển dụng nào. Vui lòng quay lại sau.</p>
  <% } %>
</div></section>
</main>

<%- include('partials/footer', { root: root, active: 'tuyen-dung' , siteImages: siteImages, footer: footer }) %>
<%- include('partials/ticker', { root: root, ticker: ticker }) %>
<%- include('partials/fab', { root: root, footer: footer }) %>
</body></html>

<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: 'Cơ hội việc làm — Synetic Group', root: root, assetVersion: assetVersion, siteImages: siteImages, fxStyle: fxStyle, fontCss: fontCss }) %></head>
<body class="t-blue">
<%- include('partials/header', { root: root, active: 'tuyen-dung', siteImages: siteImages }) %>
<%- include('partials/banner', { root: root, title: 'CƠ HỘI VIỆC LÀM', siteImages: siteImages }) %>

<main>
<section class="j-hero"<%- fx('job-hero') %>>
  <h2><%= recruit.heroTitle %></h2>
  <h3><%= recruit.heroSub %></h3>
  <% recruit.heroText.split(/\n+/).forEach(function(l) { %><p><%= l %></p><% }); %>
  <div class="j-stats">
    <% recruit.stats.forEach(function(s) { %><div><b><%= s.value %></b><span><%= s.text %></span></div>
    <% }); %>
  </div>
  <% recruit.heroText2.split(/\n+/).forEach(function(l) { %><p><%= l %></p><% }); %>
</section>

<div class="wrap">
  <div class="j-main"<%- fx('job-list') %>>
    <%- include('partials/job-side', { root: root, departments: departments, locations: locations, asForm: false }) %>
    <div data-list data-per="7" data-pager=".pager">
      <% items.forEach(function(j) { %>
      <div class="j-row" data-item data-dept="<%= j.department %>" data-loc="<%= j.area || j.location %>">
        <div class="tt"><a href="<%= root %>tuyen-dung/<%= j.slug %>.html"><%= j.title %></a>
          <% if (j.location) { %><div class="lc"><%- include('partials/icon', { name: 'pin' }) %><%= j.location %></div><% } %></div>
        <span class="dt"><%- include('partials/icon', { name: 'calendar' }) %><%= formatDateVi(j.postedAt) %></span>
        <a class="btn" href="<%= root %>tuyen-dung/<%= j.slug %>.html">Ứng tuyển ngay</a>
      </div>
      <% }); %>
      <p class="empty" data-empty style="<%= items.length ? 'display:none' : '' %>">Hiện chưa có vị trí tuyển dụng nào. Vui lòng quay lại sau.</p>
      <div class="pager"></div>
    </div>
  </div>

  <section class="why"<%- fx('job-why') %>>
    <h2><%= recruit.whyTitle %> <span><%= recruit.whyHighlight %></span></h2>
    <div class="why-grid">
      <% recruit.whyItems.forEach(function(w) { %><div><h3><%= w.title %></h3><p><%= w.text %></p></div>
      <% }); %>
    </div>
  </section>
</div>
</main>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion, fx: fx }) %>
</body></html>

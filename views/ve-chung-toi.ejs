<!DOCTYPE html>
<html lang="vi"><head><%- include('partials/head', { title: t('title.about'), desc: t('desc.about'), root: root, assetVersion: assetVersion, siteImages: siteImages, fxStyle: fxStyle, fontCss: fontCss }) %></head>
<body class="t-blue">
<%- include('partials/header', { root: root, active: 'about', siteImages: siteImages }) %>
<%- include('partials/banner', { root: root, title: t('banner.about'), siteImages: siteImages }) %>

<main>
<% if (about.chair) { %>
<section class="ab-chair" id="<%= about.chair.slug %>"<%- fx('about-chair') %> style="background-image:linear-gradient(100deg,rgba(5,35,185,.82) 0%,rgba(6,40,195,.72) 50%,rgba(6,30,160,.6) 100%),url('<%= root %><%= siteImages.chairBg %>')">
  <div class="wrap">
    <div class="ab-card" data-typing>
      <div class="tt"><% if (about.chair.t1) { %><span class="t1"><%= about.chair.t1 %></span><% } %><b><%= about.chair.t2 %></b></div>
      <% about.chair.paras.forEach(function(p) { %><p><%= p %></p>
      <% }); %>
      <% if (about.chair.sign) { %><div class="sg"><%= about.chair.sign.name %><% if (about.chair.sign.title) { %><span><%= about.chair.sign.title %></span><% } %></div><% } %>
    </div>
    <div class="ab-photo"><img src="<%= root %><%= siteImages.chairman %>" alt="<%= about.chair.sign ? about.chair.sign.name : about.chair.t2 %>"></div>
  </div>
</section>
<% } %>

<% about.extras.filter(function(ex) { return /^thong-diep/.test(ex.slug); }).forEach(function(ex) { %>
<section class="ab-block" id="<%= ex.slug %>"<%- fx('about-extras') %>><div class="wrap" style="max-width:900px">
  <h2 class="h-line"><%= ex.heading %></h2>
  <div style="margin-top:22px" class="rich">
    <% ex.paras.forEach(function(p) { %><p><%= p %></p>
    <% }); %>
    <% if (ex.sign) { %><p><strong><%= ex.sign.name %></strong><% if (ex.sign.title) { %><br><%= ex.sign.title %><% } %></p><% } %>
  </div>
</div></section>
<% }); %>

<% if (about.history) { %>
<section class="ab-block ab-hist" id="<%= about.history.slug %>"<%- fx('about-history') %>>
  <div class="wrap ab-split">
    <div>
      <h2><%= about.history.heading %></h2>
      <% about.history.paras.forEach(function(p) { %><p><%= p %></p>
      <% }); %>
    </div>
    <div class="frame"><img src="<%= root %><%= siteImages.history %>" alt="<%= about.history.heading %>" loading="lazy"></div>
  </div>
  <img class="pent-about" src="<%= root %><%= siteImages.pentagonAbout %>" alt="">
</section>
<% } %>

<%# TẦM NHÌN %>
<section class="ab-vision2" id="tam-nhin"<%- fx('about-vision') %>>
  <img class="wm l" src="<%= root %><%= siteImages.watermark %>" alt=""><img class="wm r" src="<%= root %><%= siteImages.watermark %>" alt="">
  <div class="wrap">
    <h2><%= vision.visionTitle %></h2>
    <div class="rule"></div>
    <p><%= vision.visionText %></p>
  </div>
</section>

<section class="ab-goals"<%- fx('about-goals') %>>
  <div class="gsteps">
    <% var gicons = ['goal1', 'goal2', 'goal3', 'goal4', 'goal5']; vision.goals.forEach(function(g, i) { %>
    <div class="gstep">
      <div class="gc">
        <svg viewBox="0 0 270 200" aria-hidden="true"><path d="M193.2 100 A93.7 93.7 0 1 1 177.9 48.1" fill="none" stroke="#02a02b" stroke-width="9.5" stroke-linecap="round"/><% if (i < vision.goals.length - 1) { %><path class="ar" d="M193 100 H262 M228 67 L262 100 L228 133" fill="none" stroke="#02a02b" stroke-width="9.5" stroke-linecap="round" stroke-linejoin="round"/><% } %></svg>
        <img src="<%= root %><%= siteImages[gicons[i % 5]] %>" alt="">
      </div>
      <div class="gt"><b><%= String(i + 1).padStart(2, '0') %></b><span><%= g %></span></div>
    </div>
    <% }); %>
  </div>
</section>

<section class="ab-mission" id="su-menh"<%- fx('about-mission') %>>
  <div class="ms-top" style="background-image:linear-gradient(90deg,#0702c6 0%,#0702c6 34%,rgba(7,2,198,.72) 54%,rgba(7,2,198,.08) 100%),url('<%= root %><%= siteImages.strategyBg %>')">
    <div class="wrap">
      <h2><%= vision.missionTitle %></h2>
      <p><%= vision.missionText %></p>
    </div>
  </div>
  <div class="ms-cards">
    <% vision.missionCards.forEach(function(c, i) { %>
    <article class="mscard"><b><%= String(i + 1).padStart(2, '0') %></b><h3><%= c.title %></h3><p><%= c.text %></p></article>
    <% }); %>
  </div>
</section>

<% if (coreValues.items.length) { %>
<section class="ab-values" id="gia-tri-cot-loi"<%- fx('about-values') %>>
  <div class="wrap">
  <%
  var vicons = ['val1', 'val2', 'val3', 'val4', 'val5', 'val6'];
  var vcolors = ['#0702c6', '#02a02b', '#ffb345'];
  var left = [], right = [];
  coreValues.items.slice(0, 6).forEach(function(v, i) { (i % 2 === 0 ? left : right).push({ v: v, i: i }); });
  %>
  <div class="vwheel">
    <div class="vcol l">
      <% left.forEach(function(o, k) { %>
      <div class="vp" style="--vc:<%= vcolors[k % 3] %>"><div class="vt"><h3><%= o.v.title %></h3><p><%= o.v.description %></p></div><span class="vblob"><img src="<%= root %><%= siteImages[vicons[o.i]] %>" alt=""></span></div>
      <% }); %>
    </div>
    <div class="vcenter">
      <%
      // coloured arcs round the white disc (angles in degrees, clockwise from the top), exactly on one circle
      var ringArcs = [[304, 340, '#0702c6'], [20, 56, '#0702c6'], [256, 293, '#02a02b'], [67, 104, '#02a02b'], [202, 247, '#ffb345'], [113, 158, '#ffb345']];
      function ringPt(deg) { var rad = (deg - 90) * Math.PI / 180; return (150 + 133 * Math.cos(rad)).toFixed(2) + ' ' + (150 + 133 * Math.sin(rad)).toFixed(2); }
      %>
      <svg viewBox="0 0 300 300" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <circle cx="150" cy="154" r="121" fill="#c4c4c8"/>
        <circle cx="150" cy="150" r="121" fill="#fff"/>
        <g fill="none" stroke-width="15" stroke-linecap="butt">
          <% ringArcs.forEach(function(r) { %><path d="M <%= ringPt(r[0]) %> A 133 133 0 0 1 <%= ringPt(r[1]) %>" stroke="<%= r[2] %>"/>
          <% }); %>
        </g>
      </svg>
      <div class="vctext"><%= t('ab.values1') %><br><%= t('ab.values2') %></div>
    </div>
    <div class="vcol r">
      <% right.forEach(function(o, k) { %>
      <div class="vp" style="--vc:<%= vcolors[k % 3] %>"><span class="vblob"><img src="<%= root %><%= siteImages[vicons[o.i]] %>" alt=""></span><div class="vt"><h3><%= o.v.title %></h3><p><%= o.v.description %></p></div></div>
      <% }); %>
    </div>
  </div>
  </div>
  <div class="vnote">
    <img class="wm l" src="<%= root %><%= siteImages.watermark %>" alt=""><img class="wm r" src="<%= root %><%= siteImages.watermark %>" alt="">
    <p><%= coreValues.note %></p>
  </div>
</section>
<% } %>

<% if (about.strategy) { %>
<section class="ab-strategy" id="<%= about.strategy.slug %>"<%- fx('about-strategy') %>>
  <div class="st-top" style="background-image:linear-gradient(90deg,#02a02b 0%,#02a02b 36%,rgba(2,160,43,.82) 58%,rgba(2,160,43,.28) 100%),url('<%= root %><%= siteImages.strategyBg %>')">
    <div class="wrap">
      <h2><%= about.strategy.heading %></h2>
      <% if (about.strategy.intro) { %><p class="sub"><%= about.strategy.intro %></p><% } %>
    </div>
  </div>
  <% if (about.strategy.pillars.length) { %>
  <div class="wrap pillars-wrap">
    <div class="pillars">
      <% var picons = ['pillar1', 'pillar2', 'pillar3']; about.strategy.pillars.forEach(function(p, i) { %>
      <article class="pillar c<%= i % 3 %>"><span class="pn"><%= String(i + 1).padStart(2, '0') %></span><img class="pic" src="<%= root %><%= siteImages[picons[i % 3]] %>" alt=""><h3><%= p.title %></h3><p><%= p.text %></p></article>
      <% }); %>
    </div>
  </div>
  <% } %>
  <% if (about.strategy.rest.length) { %><div class="wrap st-rest"><% about.strategy.rest.forEach(function(p) { %><p><%= p %></p><% }); %></div><% } %>
</section>
<% } %>

<% if (about.csr) { %>
<section class="ab-block ab-csr" id="<%= about.csr.slug %>"<%- fx('about-csr') %>><div class="wrap ab-split rev">
  <div class="img"><img src="<%= root %><%= siteImages.csr %>" alt="<%= about.csr.heading %>" loading="lazy"></div>
  <div class="csr-col">
    <h2><%= about.csr.heading %></h2>
    <% about.csr.plain.forEach(function(p) { %><p><%= p %></p>
    <% }); %>
    <div class="csr-list">
    <% about.csr.items.forEach(function(it) { %><div class="csr-item"><i class="dot"></i><h3><%= it.title %></h3><p><%= it.text %></p></div>
    <% }); %>
    </div>
  </div>
</div></section>
<% } %>

<% if (about.awards) { %>
<section class="ab-block ab-awards" id="<%= about.awards.slug %>"<%- fx('about-awards') %>><div class="wrap ab-split">
  <div>
    <h2><%= about.awards.heading %></h2>
    <% about.awards.paras.forEach(function(p) { %><p><%= p %></p>
    <% }); %>
  </div>
  <% var awImgs = [siteImages.award, siteImages.award2, siteImages.award3, siteImages.award4, siteImages.award5].filter(Boolean); %>
  <div class="aw-wrap">
    <% if (awImgs.length > 1) { %><div class="gal car" data-car="auto">
      <div class="frame rev"><div class="gal-v"><div class="gal-t"><% awImgs.forEach(function(s) { %><img src="<%= root %><%= s %>" alt="<%= about.awards.heading %>" loading="lazy"><% }); %></div></div></div>
      <div class="dots"></div>
    </div>
    <% } else { %><div class="frame rev"><img src="<%= root %><%= awImgs[0] %>" alt="<%= about.awards.heading %>" loading="lazy"></div><% } %>
  </div>
</div></section>
<% } %>

<% if (network.items.length) { %>
<section class="ab-net" id="mang-luoi-hoat-dong"<%- fx('about-network') %>><div class="wrap">
  <%
  var nicons = ['net1', 'net2', 'net3', 'net4', 'net5', 'net6', 'net7', 'net8'];
  var ncols = ['g', 'b', 'y', 'g'];
  var half = Math.ceil(network.items.length / 2);
  var nl = network.items.slice(0, half), nr = network.items.slice(half);
  var rows = Math.max(nl.length, nr.length);
  function npill(it, idx, row, side) {
    var edge = (row === 0 || row === rows - 1);
    return '<div class="np ' + side + ' c-' + ncols[row % 4] + (edge ? ' edge' : ' mid') + (row === 0 ? ' first' : '') + (row === rows - 1 ? ' last' : '') + '" style="grid-row:' + (row + 1) + '">' +
      (side === 'l' ? '<div class="nt"><h4>' + esc(it.title) + '</h4><p>' + esc(it.description) + '</p></div><i class="ndots"></i><span class="nico">__ICON' + idx + '__</span>' :
                      '<span class="nico">__ICON' + idx + '__</span><i class="ndots"></i><div class="nt"><h4>' + esc(it.title) + '</h4><p>' + esc(it.description) + '</p></div>') +
      '<i class="cn"></i></div>';
  }
  function esc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
  %>
  <div class="net-wrap">
  <div class="net" style="--rows:<%= rows %>">
    <% nl.forEach(function(it, i) { %><%- npill(it, i, i, 'l').replace('__ICON' + i + '__', '<img src="' + root + siteImages[nicons[i % 8]] + '" alt="">') %>
    <% }); %>
    <div class="net-center">
      <b><%= network.title %></b>
      <span class="ncl"><i></i><i></i><i></i></span>
      <p><%= network.centerText %></p>
    </div>
    <% nr.forEach(function(it, i) { %><%- npill(it, half + i, i, 'r').replace('__ICON' + (half + i) + '__', '<img src="' + root + siteImages[nicons[(half + i) % 8]] + '" alt="">') %>
    <% }); %>
    <i class="vline top"></i><i class="vline bot"></i><i class="hline top"></i><i class="hline bot"></i>
  </div>
  </div>
</div></section>
<% } %>

<% about.extras.filter(function(ex) { return !/^thong-diep/.test(ex.slug); }).forEach(function(ex) { %>
<section class="ab-block" id="<%= ex.slug %>"<%- fx('about-extras') %>><div class="wrap" style="max-width:900px">
  <h2 class="h-line"><%= ex.heading %></h2>
  <div style="margin-top:22px" class="rich">
    <% ex.paras.forEach(function(p) { %><p><%= p %></p>
    <% }); %>
    <% if (ex.sign) { %><p><strong><%= ex.sign.name %></strong><% if (ex.sign.title) { %><br><%= ex.sign.title %><% } %></p><% } %>
  </div>
</div></section>
<% }); %>

<section class="ab-team" id="doi-ngu-lanh-dao"<%- fx('about-team') %>>
  <div class="tm-band">
    <img class="wm l" src="<%= root %><%= siteImages.watermark %>" alt=""><img class="wm r" src="<%= root %><%= siteImages.watermark %>" alt="">
    <h2><%= t('ab.team') %></h2>
  </div>
  <div class="wrap">
  <% if (teamIntro.body || teamIntro.chairmanNote) { %>
  <div class="intro-t">
    <% (teamIntro.body || '').replace(/\r\n/g, '\n').split(/\n{2,}/).forEach(function(p) { %><% if (p.trim()) { %><p><%= p.trim() %></p><% } %><% }); %>
    <% if (teamIntro.chairmanNote) { %><p><strong><%= t('ab.chairnote') %></strong> <%= teamIntro.chairmanNote %>.</p><% } %>
  </div>
  <% } %>
  <% if (team.length) { %>
  <div class="t-grid">
    <% team.forEach(function(m, i) { %>
    <article class="tcard<%= i < 2 ? ' big' : '' %>">
      <div class="ph"><% if (m.photo) { %><img src="<%= root %><%= m.photo %>" alt="<%= m.name %>" loading="lazy"><% } else { %><svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="24" r="12" fill="#4b4f57"/><path d="M8 64c0-16 10-24 24-24s24 8 24 24z" fill="#4b4f57"/></svg><% } %></div>
      <div class="tb">
        <% if (m.title) { %><span class="tag"><%= m.title %></span><% } %>
        <h3><%= m.name %></h3>
        <% if (m.subtitle) { %><div class="st"><%= m.subtitle %></div><% } %>
        <% if (m.bio) { %><p><%= m.bio %></p><% } %>
        <div class="ct">
          <% if (m.year) { %><span><%- include('partials/icon', { name: 'calendar' }) %><%= m.year %></span><% } %>
          <% if (m.phone) { %><span><%- include('partials/icon', { name: 'phone' }) %><%= m.phone %></span><% } %>
          <% if (m.email) { %><span><%- include('partials/icon', { name: 'mail' }) %><%= m.email %></span><% } %>
        </div>
      </div>
    </article>
    <% }); %>
  </div>
  <% } else { %>
  <p class="intro-t" style="text-align:center"><%= t('ab.teamsoon') %></p>
  <% } %>
  </div>
</section>
</main>

<%- include('partials/footer', { root: root, siteImages: siteImages, footer: footer, contactStatus: contactStatus, back: back, assetVersion: assetVersion, fx: fx }) %>
</body></html>

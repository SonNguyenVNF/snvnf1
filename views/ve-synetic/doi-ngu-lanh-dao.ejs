<!DOCTYPE html>
<html lang="vi"><head><%- include('../partials/head', { title: 'Đội ngũ lãnh đạo — Synetic Group', root: root, assetVersion: assetVersion, siteImages: siteImages }) %></head><body>

<%- include('../partials/header', { root: root, active: null , siteImages: siteImages }) %>

<main>
<div class="abar wrap"><a href="../index.html">← Về trang chủ</a> &nbsp;/&nbsp; Về Synetic &nbsp;/&nbsp; Đội ngũ lãnh đạo</div>

<section class="ahero"><div class="wrap">
  <p class="k">VỀ SYNETIC</p>
  <h1>Đội ngũ lãnh đạo</h1>
</div></section>

<section class="abody"><div class="wrap">
  <div class="art" style="max-width:720px">
    <% pages['doi-ngu-lanh-dao-intro'].body.replace(/\r\n/g, '\n').split(/\n{2,}/).forEach(function(paragraph) { %>
      <% if (paragraph.trim()) { %><p><%= paragraph.trim() %></p><% } %>
    <% }); %>
    <p style="margin-top:8px"><b>Chủ tịch Hội đồng Quản trị:</b> <%= pages['doi-ngu-lanh-dao-intro'].chairmanNote %>.</p>
  </div>
  <% if (team.items.length) { %>
  <div class="ugrid" style="margin-top:var(--sp-5)">
    <% team.items.forEach(function(m) { %>
    <div class="ucard">
      <div class="ulogo">
        <% if (m.photo) { %><img class="mk" src="<%= root %><%= m.photo %>" alt="" style="border-radius:50%;object-fit:cover"><% } %>
        <span><b><%= m.name %></b></span>
      </div>
      <% if (m.bio) { %><p><%= m.bio %></p><% } %>
      <div class="ufoot"><%= m.title %></div>
    </div>
    <% }); %>
  </div>
  <% } else { %>
  <p class="newsempty">Thông tin chi tiết về từng thành viên Ban lãnh đạo sẽ được cập nhật đầy đủ trong thời gian tới.</p>
  <% } %>
</div></section>
</main>

<%- include('../partials/footer', { root: root, active: null , siteImages: siteImages, footer: footer, members: members }) %>
<%- include('../partials/ticker', { root: root, ticker: ticker }) %>
<%- include('../partials/fab', { root: root, footer: footer, assetVersion: assetVersion }) %>
</body></html>
